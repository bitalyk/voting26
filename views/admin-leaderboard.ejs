<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Leaderboard CMS</title><script src="https://cdn.tailwindcss.com"></script><script>sessionStorage.setItem('adminBearerToken', sessionStorage.getItem('adminBearerToken') || 'session');</script><style>body{background:#0b1220;color:#e2e8f0}</style></head>
<body class="min-h-screen antialiased"><main class="mx-auto max-w-5xl px-4 py-8"><header class="mb-6"><a href="/admin" class="text-sm text-sky-400">Settings</a><h1 class="mt-1 text-3xl font-bold text-white">Leaderboard CMS</h1><p class="mt-1 text-sm text-slate-400">Configure panel order, visibility, and localized content.</p></header><form method="POST" action="/admin/leaderboard-config"><div id="panels" class="space-y-4"><% siteConfig.leaderboardLayout.slice().sort((a,b)=>a.order-b.order).forEach((panel)=>{ %><article data-panel-id="<%= panel.panelId %>" class="rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-lg"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-lg font-bold text-white"><%= panel.panelId %></h2><div class="flex items-center gap-3"><label class="text-sm">Visible <input name="visible_<%= panel.panelId %>" type="checkbox" <%= panel.visible ? 'checked' : '' %> class="h-4 w-4 accent-rose-400" /></label><button type="button" data-move="up" class="rounded-lg border border-slate-600 px-3 py-2 text-sm">Up</button><button type="button" data-move="down" class="rounded-lg border border-slate-600 px-3 py-2 text-sm">Down</button></div></div><input name="order_<%= panel.panelId %>" type="hidden" value="<%= panel.order %>" /><div class="mt-4 grid gap-3 md:grid-cols-3"><label class="text-sm">Title (EN)<input name="<%= panel.panelId %>TitleEn" value="<%= panel.title.en || '' %>" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><label class="text-sm">Title (RU)<input name="<%= panel.panelId %>TitleRu" value="<%= panel.title.ru || '' %>" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><label class="text-sm">Title (RO)<input name="<%= panel.panelId %>TitleRo" value="<%= panel.title.ro || '' %>" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><label class="text-sm md:col-span-3">Description (EN)<textarea name="<%= panel.panelId %>DescriptionEn" rows="2" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"><%= panel.description.en || '' %></textarea></label><label class="text-sm md:col-span-3">Description (RU)<textarea name="<%= panel.panelId %>DescriptionRu" rows="2" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"><%= panel.description.ru || '' %></textarea></label><label class="text-sm md:col-span-3">Description (RO)<textarea name="<%= panel.panelId %>DescriptionRo" rows="2" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"><%= panel.description.ro || '' %></textarea></label></div></article><% }) %></div><button class="mt-5 rounded-lg bg-emerald-400 px-5 py-3 font-bold text-slate-950">Save Leaderboard</button></form></main><script>const list=document.getElementById('panels');const sync=()=>Array.from(list.children).forEach((item,index)=>item.querySelector('input[name^="order_"]').value=index);list.addEventListener('click',event=>{const button=event.target.closest('[data-move]');if(!button)return;const item=button.closest('[data-panel-id]');if(button.dataset.move==='up'&&item.previousElementSibling)list.insertBefore(item,item.previousElementSibling);if(button.dataset.move==='down'&&item.nextElementSibling)list.insertBefore(item.nextElementSibling,item);sync();});document.querySelector('form').addEventListener('submit',async(event)=>{event.preventDefault();sync();const token=sessionStorage.getItem('adminBearerToken');if(!token){location.href='/admin/login';return}const form=event.currentTarget;const response=await fetch(form.action,{method:'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:new URLSearchParams(new FormData(form))});const result=await response.json();if(!response.ok||!result.success){alert(result.error||'Save failed.');return}location.href=result.redirect;});</script></body>
</html>