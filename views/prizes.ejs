<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= t.prizeWheel %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body { background: linear-gradient(180deg, #0f172a 0%, #111827 100%); color: #e2e8f0; }
    #wheel { transform-origin: center; transition: transform 2s cubic-bezier(0.12, 0.8, 0.16, 1); }
  </style>
</head>
<body class="min-h-screen antialiased">
  <main class="mx-auto max-w-md px-4 py-5">
    <header class="mb-5 flex items-center justify-between gap-3 rounded-3xl border border-slate-700 bg-slate-900/80 p-4 shadow-xl shadow-slate-950/30">
      <div><p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-amber-300">GoCon</p><h1 class="mt-1 text-2xl font-bold text-white"><%= t.prizeWheel %></h1></div>
      <div class="flex items-center gap-2">
        <select id="languageSwitcher" aria-label="<%= t.language %>" class="rounded-full border border-slate-600 bg-slate-800 px-2 py-1 text-xs font-medium text-slate-200 outline-none">
          <option value="en" <%= lang === 'en' ? 'selected' : '' %>>EN</option>
          <option value="ru" <%= lang === 'ru' ? 'selected' : '' %>>RU</option>
          <option value="ro" <%= lang === 'ro' ? 'selected' : '' %>>RO</option>
        </select>
        <a href="/?lang=<%= lang %>" class="rounded-full border border-slate-600 px-3 py-1 text-xs font-medium text-slate-200"><%= t.home %></a>
      </div>
    </header>

    <% if (!prizes.length) { %>
      <section class="rounded-3xl border border-dashed border-slate-600 bg-slate-900/80 p-6 text-center text-slate-300"><%= t.noPrizesAvailable %></section>
    <% } else { %>
      <section class="rounded-3xl border border-slate-700 bg-slate-900/80 p-5 shadow-2xl shadow-amber-900/10">
        <div class="relative mx-auto aspect-square w-full max-w-sm">
          <div class="absolute left-1/2 top-0 z-10 h-0 w-0 -translate-x-1/2 border-x-[14px] border-t-[25px] border-x-transparent border-t-white drop-shadow"></div>
          <svg viewBox="0 0 300 300" class="h-full w-full rounded-full border-4 border-slate-200 bg-slate-800 shadow-2xl">
            <g id="wheel"></g>
            <circle cx="150" cy="150" r="30" fill="#0f172a" stroke="#e2e8f0" stroke-width="3"></circle>
            <text x="150" y="156" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700"><%= t.spin %></text>
          </svg>
        </div>
        <div class="mt-6 grid grid-cols-3 gap-2">
          <button data-spin-count="1" class="spin-button rounded-xl bg-amber-400 px-3 py-3 text-sm font-black text-slate-950 shadow-lg shadow-amber-500/20 disabled:cursor-not-allowed disabled:bg-slate-600 disabled:text-slate-300">x1 <%= t.spin %></button>
          <button data-spin-count="5" class="spin-button rounded-xl bg-sky-400 px-3 py-3 text-sm font-black text-slate-950 shadow-lg shadow-sky-500/20 disabled:cursor-not-allowed disabled:bg-slate-600 disabled:text-slate-300">x5 <%= t.spin %></button>
          <button data-spin-count="10" class="spin-button rounded-xl bg-emerald-400 px-3 py-3 text-sm font-black text-slate-950 shadow-lg shadow-emerald-500/20 disabled:cursor-not-allowed disabled:bg-slate-600 disabled:text-slate-300">x10 <%= t.spin %></button>
        </div>
        <p id="wheelStatus" class="mt-4 min-h-5 text-center text-sm text-slate-300" aria-live="polite"></p>
      </section>
    <% } %>
  </main>

  <div id="winModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="winTitle">
    <section class="w-full max-w-sm rounded-3xl border border-amber-400/50 bg-slate-900 p-6 text-center shadow-2xl">
      <p class="text-3xl"><%= t.prizeWon %></p><h2 id="winTitle" class="mt-2 text-2xl font-black text-white"><%= t.yourPrizes %></h2>
      <div id="winSummary" class="mt-5 space-y-2 text-left text-slate-200"></div>
      <button id="closeWinModal" type="button" class="mt-6 w-full rounded-xl bg-amber-400 px-4 py-3 font-black text-slate-950"><%= t.claimPrize %></button>
    </section>
  </div>

  <script>
    const prizes = <%- JSON.stringify(prizes).replace(/</g, '\\u003c') %>;
    const currentLanguage = '<%= lang %>';
    const copy = <%- JSON.stringify({ youWon: t.youWon, selectingPrizes: t.selectingPrizes, spinning: t.spinning, telegramSpinOnly: t.telegramSpinOnly }).replace(/</g, '\\u003c') %>;
    const tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
    const wheel = document.getElementById('wheel');
    const status = document.getElementById('wheelStatus');
    const modal = document.getElementById('winModal');
    const buttons = Array.from(document.querySelectorAll('.spin-button'));
    let currentRotation = 0;

    const localizedName = (name) => typeof name === 'string' ? name : (name[currentLanguage] || name.en || name.ru || name.ro || '<%= t.prize %>');
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
    const polar = (angle, radius = 145) => ({ x: 150 + radius * Math.cos(angle * Math.PI / 180), y: 150 + radius * Math.sin(angle * Math.PI / 180) });
    const sliceMetadata = [];
    const totalAmount = prizes.reduce((sum, prize) => sum + prize.amount, 0);
    let cursor = -90;
    prizes.forEach((prize) => {
      const span = prize.amount / totalAmount * 360;
      const start = polar(cursor);
      const end = polar(cursor + span);
      const largeArc = span > 180 ? 1 : 0;
      const path = span >= 359.999
        ? `<circle cx="150" cy="150" r="145" fill="${prize.color}"></circle>`
        : `<path d="M 150 150 L ${start.x} ${start.y} A 145 145 0 ${largeArc} 1 ${end.x} ${end.y} Z" fill="${prize.color}" stroke="#0f172a" stroke-width="1"></path>`;
      const midpoint = cursor + span / 2;
      const labelPoint = polar(midpoint, 92);
      const fontSize = span < 26 ? 7 : (span < 48 ? 9 : 11);
      const maxLabelLength = span < 26 ? 7 : (span < 48 ? 10 : 15);
      const label = escapeHtml(localizedName(prize.name).slice(0, maxLabelLength));
      wheel.insertAdjacentHTML('beforeend', path + `<text x="${labelPoint.x}" y="${labelPoint.y}" text-anchor="middle" dominant-baseline="middle" fill="#ffffff" font-size="${fontSize}" font-weight="700" pointer-events="none" stroke="#0f172a" stroke-width="0.8" paint-order="stroke">${label}</text>`);
      sliceMetadata.push({ prizeId: prize.prizeId, midpoint });
      cursor += span;
    });

    const setSpinning = (spinning) => buttons.forEach((button) => { button.disabled = spinning; });
    const openWinModal = (wins) => {
      const grouped = wins.reduce((groups, win) => {
        const name = localizedName(win.name);
        groups[name] = (groups[name] || 0) + 1;
        return groups;
      }, {});
      const summary = document.getElementById('winSummary');
      summary.innerHTML = wins.length === 1
        ? `<p class="rounded-xl bg-amber-400/10 p-3 text-center text-lg font-bold text-amber-100">${escapeHtml(copy.youWon)}: ${escapeHtml(Object.keys(grouped)[0])} x1!</p>`
        : `<p class="font-bold text-amber-200">${escapeHtml(copy.youWon)}:</p>${Object.entries(grouped).map(([name, amount]) => `<p class="rounded-xl bg-slate-800 px-3 py-2">${escapeHtml(name)} x${amount}</p>`).join('')}`;
      modal.classList.replace('hidden', 'flex');
    };

    buttons.forEach((button) => button.addEventListener('click', async () => {
      if (!tg || !tg.initData) { status.textContent = copy.telegramSpinOnly; return; }
      setSpinning(true);
      status.textContent = copy.selectingPrizes;
      try {
        const response = await fetch('/api/prizes/spin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ initData: tg.initData, spinCount: Number(button.dataset.spinCount) }) });
        const result = await response.json();
        if (!result.success) throw new Error(result.error || 'The spin could not be completed.');
        const finalWin = result.wins[result.wins.length - 1];
        const slice = sliceMetadata.find((item) => item.prizeId === finalWin.prizeId);
        const targetRotation = slice ? -90 - slice.midpoint : 0;
        currentRotation += 1440 + ((targetRotation - currentRotation) % 360 + 360) % 360;
        status.textContent = copy.spinning;
        wheel.style.transform = `rotate(${currentRotation}deg)`;
        window.setTimeout(() => { status.textContent = ''; openWinModal(result.wins); }, 2000);
      } catch (error) {
        status.textContent = error.message;
        setSpinning(false);
      }
    }));
    document.getElementById('closeWinModal').addEventListener('click', () => { modal.classList.replace('flex', 'hidden'); setSpinning(false); window.location.reload(); });
    document.getElementById('languageSwitcher').addEventListener('change', (event) => {
      localStorage.setItem('votingLang', event.target.value);
      window.location.href = `/prizes?lang=${encodeURIComponent(event.target.value)}`;
    });
    if (!localStorage.getItem('votingLang')) localStorage.setItem('votingLang', currentLanguage);
    if (tg) { tg.ready(); tg.expand(); }
  </script>
</body>
</html>