<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= t.leaderboardTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      background: linear-gradient(180deg, #020617 0%, #0f172a 100%);
      color: #e2e8f0;
    }
  </style>
</head>
<body class="min-h-screen antialiased">
  <div class="mx-auto max-w-md px-4 py-5">
    <header class="mb-5 rounded-3xl border border-slate-700 bg-slate-900/80 p-4 shadow-2xl shadow-sky-900/10">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-sky-400">Results</p>
          <h1 class="mt-1 text-2xl font-bold text-white"><%= t.leaderboardTitle %></h1>
        </div>
        <a href="/" class="rounded-full border border-slate-600 px-3 py-1 text-xs font-medium text-slate-200">Home</a>
      </div>
    </header>

    <% if (isLocked) { %>
      <section id="leaderboardCountdown" class="rounded-3xl border border-slate-700 bg-slate-900/80 p-5 text-center shadow-xl" data-target-time="<%= new Date(settings.leaderboardShowTimestamp).getTime() %>">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-sky-500/10 text-3xl">⏳</div>
        <h2 class="text-xl font-bold text-white"><%= t.resultsNotReady %></h2>
        <p class="mt-2 text-sm text-slate-300"><%= t.resultsLocked %></p>

        <div class="mt-5 grid grid-cols-4 gap-2 text-center">
          <div class="rounded-xl bg-slate-800 p-2">
            <div id="countdown-days" class="text-xl font-black text-white"><%= countdown.days %></div>
            <div class="text-[10px] uppercase text-slate-400"><%= t.timerDays %></div>
          </div>
          <div class="rounded-xl bg-slate-800 p-2">
            <div id="countdown-hours" class="text-xl font-black text-white"><%= countdown.hours %></div>
            <div class="text-[10px] uppercase text-slate-400"><%= t.timerHours %></div>
          </div>
          <div class="rounded-xl bg-slate-800 p-2">
            <div id="countdown-minutes" class="text-xl font-black text-white"><%= countdown.minutes %></div>
            <div class="text-[10px] uppercase text-slate-400"><%= t.timerMinutes %></div>
          </div>
          <div class="rounded-xl bg-slate-800 p-2">
            <div id="countdown-seconds" class="text-xl font-black text-white"><%= countdown.seconds %></div>
            <div class="text-[10px] uppercase text-slate-400"><%= t.timerSeconds %></div>
          </div>
        </div>
      </section>
    <% } else { %>
      <div class="space-y-5">
        <% categoryResults.forEach((category) => { %>
          <section class="rounded-3xl border border-slate-700 bg-slate-900/80 p-4 shadow-xl shadow-slate-950/20">
            <div class="mb-3 flex items-center justify-between gap-3">
              <div class="flex items-center gap-3">
                <% if (category.image) { %>
                  <img src="<%= category.image %>" alt="<%= category.categoryName %>" class="h-12 w-12 rounded-xl object-cover border border-slate-600" />
                <% } else { %>
                  <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-slate-600 bg-slate-800 text-xs font-bold text-slate-200">#</div>
                <% } %>
                <div>
                  <p class="text-sm font-bold text-white"><%= category.categoryName %></p>
                  <p class="text-[10px] uppercase tracking-[0.2em] text-slate-400">Top 3</p>
                </div>
              </div>
            </div>

            <div class="space-y-3">
              <% if (!category.candidates || !category.candidates.length) { %>
                <div class="rounded-2xl border border-dashed border-slate-600 bg-slate-800/60 p-3 text-sm text-slate-300">No votes recorded yet.</div>
              <% } else { %>
                <% category.candidates.forEach((candidate, index) => { %>
                  <div class="rounded-2xl border border-slate-700 bg-slate-800/70 p-3">
                    <div class="flex items-center justify-between gap-3">
                      <div class="flex items-center gap-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full <%= index === 0 ? 'bg-amber-400 text-slate-950' : index === 1 ? 'bg-slate-300 text-slate-950' : 'bg-amber-700 text-white' %> font-black">
                          <%= candidate.rank %>
                        </div>
                        <div>
                          <p class="text-sm font-bold text-white"><%= candidate.name %></p>
                          <% if (candidate.code) { %>
                            <p class="text-[10px] uppercase tracking-[0.2em] text-sky-300"><%= candidate.code %></p>
                          <% } %>
                        </div>
                      </div>
                      <div class="rounded-full border border-sky-500/40 bg-sky-500/10 px-2.5 py-1 text-xs font-semibold text-sky-200"><%= candidate.votes || 0 %> votes</div>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </section>
        <% }) %>
      </div>
    <% } %>
  </div>

  <script>
    const leaderboardCountdown = document.getElementById('leaderboardCountdown');
    if (leaderboardCountdown) {
      const updateLeaderboardCountdown = () => {
        const targetTime = Number(leaderboardCountdown.dataset.targetTime);
        if (!targetTime) return;

        const distance = Math.max(targetTime - Date.now(), 0);
        const totalSeconds = Math.floor(distance / 1000);
        const days = Math.floor(totalSeconds / (60 * 60 * 24));
        const hours = Math.floor((totalSeconds % (60 * 60 * 24)) / (60 * 60));
        const minutes = Math.floor((totalSeconds % (60 * 60)) / 60);
        const seconds = totalSeconds % 60;

        document.getElementById('countdown-days').textContent = days;
        document.getElementById('countdown-hours').textContent = hours;
        document.getElementById('countdown-minutes').textContent = minutes;
        document.getElementById('countdown-seconds').textContent = seconds;

        if (distance <= 0) {
          window.location.reload();
        }
      };

      updateLeaderboardCountdown();
      setInterval(updateLeaderboardCountdown, 1000);
    }
  </script>
</body>
</html>
