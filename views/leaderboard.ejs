<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Live Leaderboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        html, body {
            background: #020617;
            -webkit-overflow-scrolling: touch;
        }

        body {
            min-height: 100vh;
            overscroll-behavior-y: contain;
        }
    </style>
</head>
<body class="text-slate-100 antialiased">
    <%
        const topVote = topCandidates.reduce((max, item) => Math.max(max, item.votes), 0);
        const rankStyles = ['bg-amber-400 text-slate-950', 'bg-slate-300 text-slate-950', 'bg-amber-700 text-white'];
    %>

    <div class="mx-auto max-w-md px-4 py-5">
        <div class="rounded-3xl border border-slate-700 bg-slate-900/80 p-4 shadow-2xl shadow-sky-900/20 backdrop-blur-sm">
            <div class="mb-4 flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium uppercase tracking-[0.2em] text-sky-400">Results</p>
                    <h1 class="mt-1 text-2xl font-bold text-white">Live Leaderboard</h1>
                </div>
                <button type="button" onclick="location.reload()" class="rounded-full border border-slate-600 bg-slate-800 px-3 py-1.5 text-xs font-semibold text-slate-200">Refresh</button>
            </div>

            <div class="space-y-3">
                <% topCandidates.forEach((item, index) => { %>
                    <div class="rounded-2xl border border-slate-700 bg-slate-800/80 p-3">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3">
                                <div class="flex h-9 w-9 items-center justify-center rounded-full <%= index < 3 ? rankStyles[index] : 'bg-slate-700 text-slate-50' %> text-sm font-black">
                                    <%= index + 1 %>
                                </div>
                                <div>
                                    <p class="font-semibold text-white"><%= item.name %></p>
                                    <p class="text-[11px] uppercase tracking-[0.15em] text-slate-400"><%= item.categoryName %></p>
                                </div>
                            </div>
                            <div class="rounded-full border border-sky-500/50 bg-sky-500/10 px-2.5 py-1 text-xs font-semibold text-sky-300">
                                <%= item.votes %> votes
                            </div>
                        </div>

                        <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-slate-700">
                            <div
                                class="bar-fill h-full rounded-full bg-gradient-to-r from-sky-400 via-cyan-400 to-emerald-400"
                                data-votes="<%= item.votes %>"
                                data-max="<%= topVote || 1 %>"
                            ></div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.bar-fill').forEach((bar) => {
            const votes = Number(bar.dataset.votes || 0);
            const maxVotes = Number(bar.dataset.max || 1);
            const width = Math.max((votes / maxVotes) * 100, 8);
            bar.style.width = width + '%';
        });

        setInterval(() => {
            window.location.reload();
        }, 20000);
    </script>
</body>
</html>