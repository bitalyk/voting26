<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Map Editor</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>body{background:#0b1220;color:#e2e8f0}.map-pin{transform:translate(-50%,-50%)}.map-pin:focus{outline:2px solid #fbbf24}</style>
</head>
<body class="min-h-screen">
  <main id="mapEditor" data-map="<%= JSON.stringify(map) %>" data-event-types="<%= JSON.stringify(eventTypes) %>" data-marker-categories="<%= JSON.stringify(markerCategories) %>" class="mx-auto max-w-6xl p-4">
    <a href="/admin/interactive-map" class="text-sm text-sky-300">Maps</a><h1 class="mt-2 text-3xl font-bold text-white">Map Editor</h1>
    <form id="detailsForm" class="mt-5 grid gap-3 rounded-lg border border-slate-700 bg-slate-900 p-4 md:grid-cols-3" enctype="multipart/form-data">
      <input type="hidden" name="mapId" value="<%= map.mapId %>" /><input name="nameEn" placeholder="Map name (English)" value="<%= map.name.en || '' %>" class="rounded bg-slate-800 p-2" /><input name="nameRu" placeholder="Map name (Russian)" value="<%= map.name.ru || '' %>" class="rounded bg-slate-800 p-2" /><input name="nameRo" placeholder="Map name (Romanian)" value="<%= map.name.ro || '' %>" class="rounded bg-slate-800 p-2" /><input name="image" type="file" accept="image/*" class="md:col-span-2" /><label class="flex items-center gap-2 text-sm">Default map <input name="isDefault" type="checkbox" value="true" <%= map.isDefault ? 'checked' : '' %> /></label><label class="flex items-center gap-2 text-sm">Show on public map <input name="isVisible" type="checkbox" value="true" <%= map.isVisible !== false ? 'checked' : '' %> /></label><% if (!map.imageUrl) { %><button class="rounded bg-emerald-400 p-2 font-bold text-slate-950">Upload Map & Continue</button><% } %>
    </form>
    <% if (!map.imageUrl) { %><p class="mt-6 text-center text-slate-300">Please upload a map image to start placing events.</p><% } else { %>
      <div class="mt-5 grid gap-4 lg:grid-cols-[1fr_330px]"><section id="mapCanvas" class="overflow-hidden rounded-lg border border-slate-700"><div id="mapStage" class="relative"><img id="mapImage" src="<%= map.imageUrl %>" class="block w-full select-none" draggable="false" alt="Map" /><div id="mapPins" class="absolute inset-0"></div></div></section><aside class="rounded-lg border border-slate-700 bg-slate-900 p-4"><div class="flex items-center justify-between"><h2 class="font-bold">Marker Categories</h2><button id="addCategory" type="button" class="text-sm text-sky-300">Add Category</button></div><div id="markerCategories" class="mt-3 space-y-2"></div><div class="mt-5 border-t border-slate-700 pt-4"><div class="flex items-center justify-between"><h2 class="font-bold">Event Types</h2><button id="addType" type="button" class="text-sm text-sky-300">Add Event Type</button></div><div id="eventTypes" class="mt-3 space-y-2"></div></div><div class="mt-5 border-t border-slate-700 pt-4"><div class="flex items-center justify-between"><h2 class="font-bold">Legend</h2><button id="addLegend" type="button" class="text-sm text-sky-300">Add to Legend</button></div><div id="legendItems" class="mt-3 space-y-2"></div></div><button id="saveEditor" type="button" class="mt-5 w-full rounded bg-emerald-400 p-3 font-bold text-slate-950">Confirm / Save Changes</button></aside></div>
    <% } %>
  </main>
  <div id="typeModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4"><form id="typeForm" class="w-full max-w-lg rounded-lg bg-slate-900 p-5" enctype="multipart/form-data"><h2 id="typeModalTitle" class="text-xl font-bold">Add Event Type</h2><div class="mt-4 grid gap-2"><input name="nameEn" required placeholder="Name (English)" class="rounded bg-slate-800 p-2" /><input name="nameRu" placeholder="Name (Russian)" class="rounded bg-slate-800 p-2" /><input name="nameRo" placeholder="Name (Romanian)" class="rounded bg-slate-800 p-2" /><select id="typeCategoryId" name="categoryId" class="rounded bg-slate-800 p-2"></select><textarea name="descriptionEn" placeholder="Description (English)" class="rounded bg-slate-800 p-2"></textarea><textarea name="descriptionRu" placeholder="Description (Russian)" class="rounded bg-slate-800 p-2"></textarea><textarea name="descriptionRo" placeholder="Description (Romanian)" class="rounded bg-slate-800 p-2"></textarea><input name="image" type="file" accept="image/*" /><button class="rounded bg-sky-400 p-2 font-bold text-slate-950">Save Event Type</button><button data-close="typeModal" type="button" class="text-slate-300">Cancel</button></div></form></div>
  <div id="categoryModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4"><form id="categoryForm" class="w-full max-w-lg rounded-lg bg-slate-900 p-5"><h2 id="categoryModalTitle" class="text-xl font-bold">Add Marker Category</h2><div class="mt-4 grid gap-2"><input name="nameEn" required placeholder="Category name (English)" class="rounded bg-slate-800 p-2" /><input name="nameRu" placeholder="Category name (Russian)" class="rounded bg-slate-800 p-2" /><input name="nameRo" placeholder="Category name (Romanian)" class="rounded bg-slate-800 p-2" /><label class="grid gap-1 text-sm">Marker border color <input name="color" type="color" value="#38bdf8" class="h-10 w-full rounded bg-slate-800 p-1" /></label><button class="rounded bg-sky-400 p-2 font-bold text-slate-950">Save Category</button><button data-close="categoryModal" type="button" class="text-slate-300">Cancel</button></div></form></div>
  <div id="deleteCategoryModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4"><section class="w-full max-w-sm rounded-lg bg-slate-900 p-5"><h2 class="text-xl font-bold">Delete Marker Category?</h2><p class="mt-2 text-sm text-slate-400">Linked event types will become uncategorized and use the default marker border.</p><div class="mt-5 flex justify-end gap-3"><button data-close="deleteCategoryModal" type="button" class="rounded border border-slate-600 px-3 py-2">Cancel</button><button id="confirmDeleteCategory" type="button" class="rounded bg-red-500 px-3 py-2 font-bold text-white">Delete Category</button></div></section></div>
  <div id="placeMarkerModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4"><section class="w-full max-w-sm rounded-lg bg-slate-900 p-5"><h2 class="text-xl font-bold">Choose Event Type</h2><p class="mt-1 text-sm text-slate-400">Select the event to place at this map location.</p><div id="markerTypeChoices" class="mt-4 grid gap-2"></div><button data-close="placeMarkerModal" type="button" class="mt-4 w-full rounded border border-slate-600 px-3 py-2 text-slate-200">Cancel</button></section></div>
  <div id="markerModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4"><section class="w-full max-w-sm rounded-lg bg-slate-900 p-5"><h2 id="markerTitle" class="text-xl font-bold"></h2><p id="markerType" class="mt-1 text-sm text-slate-400"></p><div class="mt-5 flex justify-end gap-3"><button data-close="markerModal" class="rounded border border-slate-600 px-3 py-2">Cancel</button><button id="removeMarker" class="rounded bg-red-500 px-3 py-2 font-bold text-white">Remove Marker from Map</button></div></section></div>
  <div id="legendModal" class="fixed inset-0 z-20 hidden items-center justify-center bg-slate-950/80 p-4"><form id="legendForm" class="w-full max-w-lg rounded-lg bg-slate-900 p-5"><h2 class="text-xl font-bold">Edit Legend Name</h2><p class="mt-1 text-sm text-slate-400">Set the label shown in the legend for each public language.</p><input id="legendTypeId" type="hidden" /><div class="mt-4 grid gap-3"><label class="grid gap-1 text-sm font-medium">English (EN)<input id="legendNameEn" placeholder="Legend name in English" class="rounded bg-slate-800 p-2 font-normal" /></label><label class="grid gap-1 text-sm font-medium">Russian (RU)<input id="legendNameRu" placeholder="Название легенды на русском" class="rounded bg-slate-800 p-2 font-normal" /></label><label class="grid gap-1 text-sm font-medium">Romanian (RO)<input id="legendNameRo" placeholder="Nume legendă în română" class="rounded bg-slate-800 p-2 font-normal" /></label><button class="rounded bg-sky-400 p-2 font-bold text-slate-950">Save Localized Legend Names</button><button data-close="legendModal" type="button" class="text-slate-300">Cancel</button></div></form></div>
  <script>
    const editor = document.getElementById('mapEditor');
    const map = JSON.parse(editor.dataset.map); const mapId = String(map.mapId || '');
    const api = async (url, options = {}) => { const response = await fetch(url, { ...options, headers: { ...(options.headers || {}), Authorization: `Bearer ${sessionStorage.getItem('adminBearerToken') || ''}` } }); const contentType = response.headers.get('content-type') || ''; if (!contentType.includes('application/json')) throw new Error(`The server returned an unexpected response (${response.status}). Refresh the page and try again.`); const result = await response.json(); if (!response.ok || !result.success) throw new Error(result.error || 'Request failed.'); return result; };
    const show = (id) => document.getElementById(id)?.classList.replace('hidden', 'flex');
    const hide = (id) => document.getElementById(id)?.classList.replace('flex', 'hidden');
    document.querySelectorAll('[data-close]').forEach((button) => button.addEventListener('click', () => hide(button.dataset.close)));
    document.getElementById('detailsForm').addEventListener('submit', async (event) => { event.preventDefault(); if (map.imageUrl) return; try { await api(`/api/admin/maps/${encodeURIComponent(mapId)}/details`, { method: 'POST', body: new FormData(event.currentTarget) }); location.reload(); } catch (error) { alert(error.message); } });
    const canvas = document.getElementById('mapStage');
    if (canvas) {
      let types = JSON.parse(editor.dataset.eventTypes); let categories = JSON.parse(editor.dataset.markerCategories); let placedEvents = [...(map.placedEvents || [])]; let legend = [...(map.legend || [])]; let editingTypeId = ''; let editingCategoryId = ''; let deletingCategoryId = ''; let selectedMarkerId = ''; let pendingMarkerPosition = null;
      const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
      const byId = () => Object.fromEntries(types.map((type) => [type.eventTypeId, type]));
      const categoryById = () => Object.fromEntries(categories.map((category) => [category.categoryId, category]));
      const localized = (value) => (value && (value.en || value.ru || value.ro)) || '';
      const categoryColor = (type) => categoryById()[type?.categoryId]?.color || '#0ea5e9';
      const renderCategoryOptions = () => { document.getElementById('typeCategoryId').innerHTML = `<option value="">No category (default blue)</option>${categories.map((category) => `<option value="${escapeHtml(category.categoryId)}">${escapeHtml(localized(category.name) || category.categoryId)}</option>`).join('')}`; };
      const normalizedMarkerIcons = new Map();
      const normalizeMarkerIcon = (image) => { const source = image.currentSrc || image.src; if (!source) return Promise.resolve(source); const cached = normalizedMarkerIcons.get(source); if (cached) { image.src = cached; return Promise.resolve(cached); } return new Promise((resolve) => { const original = new Image(); original.onload = () => { const side = Math.min(original.naturalWidth, original.naturalHeight); const cropX = Math.floor((original.naturalWidth - side) / 2); const cropY = Math.floor((original.naturalHeight - side) / 2); const cropped = document.createElement('canvas'); cropped.width = side; cropped.height = side; cropped.getContext('2d').drawImage(original, cropX, cropY, side, side, 0, 0, side, side); const normalized = cropped.toDataURL('image/png'); normalizedMarkerIcons.set(source, normalized); resolve(normalized); }; original.onerror = () => resolve(source); original.src = source; }).then((normalized) => { image.src = normalized; return normalized; }); };
      const render = () => { const typeIndex = byId(); renderCategoryOptions(); legend.sort((left, right) => left.order - right.order); document.getElementById('markerCategories').innerHTML = categories.map((category) => `<div class="flex items-center justify-between gap-2 rounded bg-slate-800 p-2 text-sm"><span class="flex min-w-0 items-center gap-2 truncate"><i class="h-4 w-4 shrink-0 rounded-full border-2" style="border-color:${escapeHtml(category.color)}"></i>${escapeHtml(localized(category.name))}</span><span class="shrink-0"><button class="edit-category text-sky-300" data-id="${category.categoryId}">Edit</button> <button class="remove-category text-red-300" data-id="${category.categoryId}">Delete</button></span></div>`).join('') || '<p class="text-sm text-slate-400">No categories yet.</p>'; document.getElementById('eventTypes').innerHTML = types.map((type) => `<div class="flex items-center justify-between gap-2 rounded bg-slate-800 p-2 text-sm"><span class="flex min-w-0 items-center gap-2 truncate"><i class="h-4 w-4 shrink-0 rounded-full border-2" style="border-color:${escapeHtml(categoryColor(type))}"></i>${escapeHtml(localized(type.name))}</span><span class="shrink-0"><button class="edit-type text-sky-300" data-id="${type.eventTypeId}">Edit</button> <button class="remove-type text-red-300" data-id="${type.eventTypeId}">Remove</button></span></div>`).join(''); document.getElementById('mapPins').innerHTML = placedEvents.map((event) => { const type = typeIndex[event.eventTypeId]; const name = localized(type?.name) || '+'; return `<button type="button" class="map-pin absolute flex h-10 w-10 items-center justify-center overflow-hidden rounded-full border-[3px] bg-transparent p-0 text-center text-xs font-bold text-slate-950 shadow-lg" data-id="${event.instanceId}" title="${escapeHtml(name)}" style="left:${event.xPercent}%;top:${event.yPercent}%;border-color:${escapeHtml(categoryColor(type))}">${type?.symbolIcon ? `<img src="${escapeHtml(type.symbolIcon)}" class="marker-icon h-full w-full rounded-full object-cover" alt="" />` : `<span class="block truncate">${escapeHtml(name)}</span>`}</button>`; }).join(''); document.querySelectorAll('.marker-icon').forEach((image) => image.addEventListener('load', (event) => normalizeMarkerIcon(event.currentTarget), { once: true })); document.getElementById('legendItems').innerHTML = legend.map((item, index) => `<div class="flex items-center gap-2 rounded bg-slate-800 p-2 text-sm"><span class="min-w-0 flex-1 truncate">${escapeHtml(localized(item.customName) || localized(typeIndex[item.eventTypeId]?.name))}</span><button class="legend-up text-sky-300 disabled:text-slate-600" data-index="${index}" ${index === 0 ? 'disabled' : ''}>Up</button><button class="legend-down text-sky-300 disabled:text-slate-600" data-index="${index}" ${index === legend.length - 1 ? 'disabled' : ''}>Down</button><button class="edit-legend text-sky-300" data-id="${item.eventTypeId}">Edit</button><button class="remove-legend text-red-300" data-index="${index}">Remove</button></div>`).join(''); };
      const typeForm = document.getElementById('typeForm');
      document.getElementById('addType').onclick = () => { editingTypeId = ''; document.getElementById('typeModalTitle').textContent = 'Add Event Type'; if (typeForm) typeForm.reset(); renderCategoryOptions(); show('typeModal'); };
      typeForm?.addEventListener('submit', async (event) => { event.preventDefault(); try { const url = editingTypeId ? `/api/admin/map-event-types/${encodeURIComponent(editingTypeId)}/update` : '/api/admin/map-event-types'; const result = await api(url, { method: 'POST', body: new FormData(typeForm) }); if (editingTypeId) types = types.map((type) => type.eventTypeId === editingTypeId ? result.eventType : type); else types.push(result.eventType); if (typeForm) typeForm.reset(); hide('typeModal'); render(); } catch (error) { alert(error.message); } });
      document.getElementById('eventTypes').onclick = async (event) => { const editButton = event.target.closest('.edit-type'); const removeButton = event.target.closest('.remove-type'); if (editButton) { const type = types.find((entry) => entry.eventTypeId === editButton.dataset.id); if (!type) return; editingTypeId = type.eventTypeId; document.getElementById('typeModalTitle').textContent = 'Edit Event Type'; ['en', 'ru', 'ro'].forEach((language) => { typeForm.elements[`name${language[0].toUpperCase()}${language.slice(1)}`].value = type.name[language] || ''; typeForm.elements[`description${language[0].toUpperCase()}${language.slice(1)}`].value = type.description[language] || ''; }); renderCategoryOptions(); typeForm.elements.categoryId.value = type.categoryId || ''; show('typeModal'); return; } if (!removeButton || !confirm('Remove this event type and all its markers?')) return; try { await api(`/api/admin/map-event-types/${encodeURIComponent(removeButton.dataset.id)}/delete`, { method: 'POST' }); types = types.filter((type) => type.eventTypeId !== removeButton.dataset.id); placedEvents = placedEvents.filter((item) => item.eventTypeId !== removeButton.dataset.id); legend = legend.filter((item) => item.eventTypeId !== removeButton.dataset.id); render(); } catch (error) { alert(error.message); } };
      const categoryForm = document.getElementById('categoryForm');
      document.getElementById('addCategory').onclick = () => { editingCategoryId = ''; document.getElementById('categoryModalTitle').textContent = 'Add Marker Category'; categoryForm.reset(); categoryForm.elements.color.value = '#38bdf8'; show('categoryModal'); };
      categoryForm.addEventListener('submit', async (event) => { event.preventDefault(); try { const result = await api(editingCategoryId ? `/api/admin/marker-categories/${encodeURIComponent(editingCategoryId)}/update` : '/api/admin/marker-categories', { method: 'POST', body: new FormData(categoryForm) }); if (editingCategoryId) categories = categories.map((category) => category.categoryId === editingCategoryId ? result.category : category); else categories.push(result.category); hide('categoryModal'); render(); } catch (error) { alert(error.message); } });
      document.getElementById('markerCategories').onclick = (event) => { const editButton = event.target.closest('.edit-category'); const removeButton = event.target.closest('.remove-category'); if (editButton) { const category = categories.find((entry) => entry.categoryId === editButton.dataset.id); if (!category) return; editingCategoryId = category.categoryId; document.getElementById('categoryModalTitle').textContent = 'Edit Marker Category'; ['en', 'ru', 'ro'].forEach((language) => categoryForm.elements[`name${language[0].toUpperCase()}${language.slice(1)}`].value = category.name?.[language] || ''); categoryForm.elements.color.value = category.color; show('categoryModal'); return; } if (removeButton) { deletingCategoryId = removeButton.dataset.id; show('deleteCategoryModal'); } };
      document.getElementById('confirmDeleteCategory').onclick = async () => { if (!deletingCategoryId) return; try { await api(`/api/admin/marker-categories/${encodeURIComponent(deletingCategoryId)}/delete`, { method: 'POST' }); categories = categories.filter((category) => category.categoryId !== deletingCategoryId); types = types.map((type) => type.categoryId === deletingCategoryId ? { ...type, categoryId: '' } : type); deletingCategoryId = ''; hide('deleteCategoryModal'); render(); } catch (error) { alert(error.message); } };
      document.getElementById('mapPins').onclick = (event) => { const marker = event.target.closest('.map-pin'); if (!marker) return; event.stopPropagation(); const item = placedEvents.find((entry) => entry.instanceId === marker.dataset.id); const type = item && byId()[item.eventTypeId]; if (!item || !type) return; selectedMarkerId = item.instanceId; document.getElementById('markerTitle').textContent = localized(type.name); document.getElementById('markerType').textContent = `Event type ID: ${type.eventTypeId}`; show('markerModal'); };
      document.getElementById('removeMarker').onclick = () => { placedEvents = placedEvents.filter((item) => item.instanceId !== selectedMarkerId); selectedMarkerId = ''; hide('markerModal'); render(); };
      canvas.addEventListener('click', (event) => { if (event.target.closest('.map-pin')) return; if (!types.length) return alert('Create an event type first.'); const bounds = document.getElementById('mapImage').getBoundingClientRect(); const xPercent = ((event.clientX - bounds.left) / bounds.width) * 100; const yPercent = ((event.clientY - bounds.top) / bounds.height) * 100; if (xPercent < 0 || xPercent > 100 || yPercent < 0 || yPercent > 100) return; pendingMarkerPosition = { xPercent, yPercent }; document.getElementById('markerTypeChoices').innerHTML = types.map((type) => `<button type="button" class="place-marker-type flex items-center gap-3 rounded border border-slate-700 bg-slate-800 p-3 text-left hover:border-sky-400" data-id="${type.eventTypeId}">${type.symbolIcon ? `<img src="${escapeHtml(type.symbolIcon)}" class="h-9 w-9 rounded-full border-2 object-cover" style="border-color:${escapeHtml(categoryColor(type))}" alt="" />` : `<span class="flex h-9 w-9 items-center justify-center rounded-full border-2 font-bold text-slate-950" style="border-color:${escapeHtml(categoryColor(type))}">+</span>`}<span class="min-w-0 truncate font-medium">${escapeHtml(localized(type.name) || type.eventTypeId)}</span></button>`).join(''); show('placeMarkerModal'); });
      document.getElementById('markerTypeChoices').onclick = (event) => { const button = event.target.closest('.place-marker-type'); if (!button || !pendingMarkerPosition) return; placedEvents.push({ instanceId: crypto.randomUUID(), eventTypeId: button.dataset.id, ...pendingMarkerPosition }); pendingMarkerPosition = null; hide('placeMarkerModal'); render(); };
      document.getElementById('addLegend').onclick = () => { const missing = types.find((type) => !legend.some((item) => item.eventTypeId === type.eventTypeId)); if (!missing) return alert('All events are already added'); legend.push({ eventTypeId: missing.eventTypeId, customName: {}, symbolIcon: missing.symbolIcon, order: legend.length }); render(); };
      document.getElementById('legendItems').onclick = (event) => { const index = Number(event.target.closest('[data-index]')?.dataset.index); const button = event.target.closest('button'); if (!button) return; if (button.classList.contains('legend-up') && index > 0) [legend[index - 1], legend[index]] = [legend[index], legend[index - 1]]; else if (button.classList.contains('legend-down') && index < legend.length - 1) [legend[index + 1], legend[index]] = [legend[index], legend[index + 1]]; else if (button.classList.contains('remove-legend')) legend.splice(index, 1); else if (button.classList.contains('edit-legend')) { const item = legend.find((entry) => entry.eventTypeId === button.dataset.id); const type = item && byId()[item.eventTypeId]; if (!item) return; document.getElementById('legendTypeId').value = item.eventTypeId; ['en', 'ru', 'ro'].forEach((language) => document.getElementById(`legendName${language[0].toUpperCase()}${language.slice(1)}`).value = item.customName?.[language] || type?.name?.[language] || ''); show('legendModal'); return; } else return; legend.forEach((item, order) => { item.order = order; }); render(); };
      document.getElementById('legendForm').addEventListener('submit', (event) => { event.preventDefault(); const item = legend.find((entry) => entry.eventTypeId === document.getElementById('legendTypeId').value); if (item) item.customName = { en: document.getElementById('legendNameEn').value.trim(), ru: document.getElementById('legendNameRu').value.trim(), ro: document.getElementById('legendNameRo').value.trim() }; hide('legendModal'); render(); });
      document.getElementById('saveEditor').onclick = async () => { legend.forEach((item, order) => { item.order = order; }); const form = document.getElementById('detailsForm'); if (!form) return; const formData = new FormData(form); formData.set('mapId', mapId); formData.set('isVisible', form.elements.isVisible?.checked ? 'true' : 'false'); formData.set('editorState', JSON.stringify({ placedEvents, legend })); try { const result = await api(`/api/admin/maps/${encodeURIComponent(mapId)}/save`, { method: 'POST', body: formData }); location.href = result.redirect; } catch (error) { alert(error.message); } };
      render();
    }
  </script>
</body>
</html>