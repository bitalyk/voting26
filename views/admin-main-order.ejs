<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Main Page Order</title><script src="https://cdn.tailwindcss.com"></script><script>sessionStorage.setItem('adminBearerToken', sessionStorage.getItem('adminBearerToken') || 'session');</script><style>body{background:#0b1220;color:#e2e8f0}</style></head>
<body class="min-h-screen antialiased"><main class="mx-auto max-w-2xl px-4 py-8"><header class="mb-6"><a href="/admin/main-page" class="text-sm text-sky-400">Main Page CMS</a><h1 class="mt-1 text-3xl font-bold text-white">Panel Order</h1><p class="mt-1 text-sm text-slate-400">Use the arrows to define the top-to-bottom order shown to visitors.</p></header><form method="POST" action="/admin/main-page/order"><div id="panels" class="space-y-3"><% siteConfig.mainPageLayout.slice().sort((a,b)=>a.order-b.order).forEach((panel)=>{ %><article data-panel-id="<%= panel.panelId %>" class="flex items-center justify-between gap-3 rounded-xl border border-slate-700 bg-slate-900 p-4"><span class="font-bold text-white"><%= panel.panelId %></span><span class="flex gap-2"><button type="button" data-move="up" class="rounded-lg border border-slate-600 px-3 py-2 text-sm">Up</button><button type="button" data-move="down" class="rounded-lg border border-slate-600 px-3 py-2 text-sm">Down</button></span></article><% }) %></div><input id="panelIds" name="panelIds" type="hidden" /><button class="mt-5 rounded-lg bg-emerald-400 px-5 py-3 font-bold text-slate-950">Save Layout Order</button></form></main><script>const list=document.getElementById('panels');const sync=()=>document.getElementById('panelIds').value=Array.from(list.children).map(item=>item.dataset.panelId).join(',');list.addEventListener('click',event=>{const button=event.target.closest('[data-move]');if(!button)return;const item=button.closest('[data-panel-id]');if(button.dataset.move==='up'&&item.previousElementSibling)list.insertBefore(item,item.previousElementSibling);if(button.dataset.move==='down'&&item.nextElementSibling)list.insertBefore(item.nextElementSibling,item);sync();});document.querySelector('form').addEventListener('submit',async(event)=>{event.preventDefault();sync();const token=sessionStorage.getItem('adminBearerToken');if(!token){location.href='/admin/login';return}const form=event.currentTarget;const response=await fetch(form.action,{method:'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:new URLSearchParams(new FormData(form))});const result=await response.json();if(!response.ok||!result.success){alert(result.error||'Save failed.');return}location.href=result.redirect;});sync();</script></body>
</html>