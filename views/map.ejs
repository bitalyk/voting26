<% const copy = { en: { title: 'Interactive Map', select: 'Map', legend: 'Legend', empty: 'No event maps available yet.', home: 'Home', close: 'Close', language: 'Language' }, ru: { title: 'Интерактивная карта', select: 'Карта', legend: 'Легенда', empty: 'Карты событий пока нет.', home: 'Главная', close: 'Закрыть', language: 'Язык' }, ro: { title: 'Hartă interactivă', select: 'Hartă', legend: 'Legendă', empty: 'Nu există hărți de evenimente încă.', home: 'Acasă', close: 'Închide', language: 'Limbă' } }[lang]; %>
<!DOCTYPE html>
<html lang="<%= lang %>"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><title><%= copy.title %></title><script src="https://cdn.tailwindcss.com"></script><script src="https://unpkg.com/@panzoom/panzoom@4.5.1/dist/panzoom.min.js"></script><style>html,body{height:100%;overflow:hidden}body{background:#07111f;color:#e2e8f0}.map-viewport{height:100dvh;touch-action:none}.marker-control{width:40px;height:40px;transform:translate(-50%,-50%) scale(1);transform-origin:50% 50%;touch-action:manipulation}.marker-icon{display:block;width:100%;height:100%}.map-fab{position:absolute;right:20px;bottom:max(20px,env(safe-area-inset-bottom));z-index:10}.map-controls{position:absolute;left:16px;right:16px;top:max(16px,env(safe-area-inset-top));z-index:10;display:flex;align-items:center;justify-content:space-between}.map-round-control{width:46px;height:46px;border-radius:9999px;border:1px solid rgba(148,163,184,.55);background:rgba(15,23,42,.9);color:#e2e8f0;box-shadow:0 8px 24px rgba(2,6,23,.4)}.map-home-control{width:auto;min-width:70px;padding:0 12px;font-size:.875rem}.map-select-control{position:absolute;left:50%;width:calc(100% - 164px);min-width:120px;max-width:220px;transform:translateX(-50%)}.map-round-control select{width:100%;height:100%;border-radius:inherit;background:transparent;text-align:center;color:inherit;appearance:none}.map-select-control select{padding:0 14px;text-align:left;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.modal{background:rgba(2,6,23,.82)}</style></head>
<body><main id="mapPage" data-maps="<%= JSON.stringify(maps) %>" data-event-types="<%= JSON.stringify(eventTypes) %>" data-marker-categories="<%= JSON.stringify(markerCategories) %>" class="h-full"><% if (!maps.length) { %><div class="flex h-full items-center justify-center p-6 text-center text-slate-300"><%= copy.empty %></div><% } else { %><section id="viewer" class="map-viewport relative overflow-hidden bg-slate-950"><div id="scene" class="relative w-full origin-top-left"><img id="mapImage" class="block w-full select-none" draggable="false" alt="" /><div id="markers"></div></div><div class="map-controls"><a href="/?lang=<%= lang %>" aria-label="<%= copy.home %>" title="<%= copy.home %>" class="map-round-control map-home-control flex items-center justify-center"><%= copy.home %></a><label class="map-round-control map-select-control" title="<%= copy.select %>"><select id="mapSelect" aria-label="<%= copy.select %>"><% maps.forEach((map, index) => { %><option value="<%= map.mapId %>"><%= (map.name && (map.name[lang] || map.name.en || map.name.ru || map.name.ro)) || (index + 1) %></option><% }) %></select></label><label class="map-round-control" title="<%= copy.language %>"><select id="language" aria-label="<%= copy.language %>"><option value="en" <%= lang === 'en' ? 'selected' : '' %>>EN</option><option value="ru" <%= lang === 'ru' ? 'selected' : '' %>>RU</option><option value="ro" <%= lang === 'ro' ? 'selected' : '' %>>RO</option></select></label></div><button id="legendButton" type="button" class="map-fab rounded-full bg-amber-400 px-5 py-3 font-bold text-slate-950 shadow-xl"><%= copy.legend %></button></section><% } %></main><div id="dialog" class="modal fixed inset-0 z-20 hidden items-end justify-center p-4"><article class="w-full max-w-md rounded-lg bg-slate-900 p-5"><button id="closeDialog" type="button" class="float-right text-slate-300"><%= copy.close %></button><div id="dialogContent" class="pr-8"></div></article></div>
<script>
  const page = document.getElementById('mapPage');
  const maps = JSON.parse(page.dataset.maps || '[]'); const types = JSON.parse(page.dataset.eventTypes || '[]'); const markerCategories = JSON.parse(page.dataset.markerCategories || '[]'); const language = '<%= lang %>';
  const typeById = Object.fromEntries(types.map((type) => [type.eventTypeId, type])); let panzoom; let currentScale = 1; let constrainPan = () => {}; let focusEventType = () => {};
  const categoryById = Object.fromEntries(markerCategories.map((category) => [category.categoryId, category]));
  const text = (value) => typeof value === 'string' ? value : (value && (value[language] || value.en || value.ru || value.ro)) || '';
  const categoryFor = (type) => categoryById[type?.categoryId] || null;
  const categoryColor = (type) => categoryFor(type)?.color || '#0ea5e9';
  const escapeHtml = (value) => String(value || '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
  const dialog = document.getElementById('dialog'); const openDialog = (content) => { document.getElementById('dialogContent').innerHTML = content; dialog.classList.replace('hidden', 'flex'); };
  const normalizedMarkerIcons = new Map();
  const normalizeMarkerIcon = (image) => { const source = image.currentSrc || image.src; if (!source) return Promise.resolve(source); const cached = normalizedMarkerIcons.get(source); if (cached) { image.src = cached; return Promise.resolve(cached); } return new Promise((resolve) => { const original = new Image(); original.onload = () => { const side = Math.min(original.naturalWidth, original.naturalHeight); const cropX = Math.floor((original.naturalWidth - side) / 2); const cropY = Math.floor((original.naturalHeight - side) / 2); const cropped = document.createElement('canvas'); cropped.width = side; cropped.height = side; cropped.getContext('2d').drawImage(original, cropX, cropY, side, side, 0, 0, side, side); const normalized = cropped.toDataURL('image/png'); normalizedMarkerIcons.set(source, normalized); resolve(normalized); }; original.onerror = () => resolve(source); original.src = source; }).then((normalized) => { image.src = normalized; return normalized; }); };
  const updateMarkerScale = (scale) => { currentScale = scale || 1; document.querySelectorAll('.marker-control').forEach((marker) => { marker.style.transform = `translate(-50%, -50%) scale(${1 / currentScale})`; }); };
  const renderMap = (mapId) => { const map = maps.find((entry) => entry.mapId === mapId) || maps[0]; const markers = document.getElementById('markers'); const image = document.getElementById('mapImage'); markers.innerHTML = ''; (map.placedEvents || []).forEach((event) => { const type = typeById[event.eventTypeId]; if (!type) return; const marker = document.createElement('button'); marker.type = 'button'; marker.className = 'marker-control absolute flex items-center justify-center overflow-hidden rounded-full border-[3px] bg-transparent p-0 shadow-lg'; marker.dataset.eventTypeId = event.eventTypeId; marker.style.left = `${event.xPercent}%`; marker.style.top = `${event.yPercent}%`; marker.style.borderColor = categoryColor(type); marker.setAttribute('aria-label', text(type.name)); marker.innerHTML = type.symbolIcon ? `<img src="${escapeHtml(type.symbolIcon)}" class="marker-icon rounded-full object-cover" alt="" />` : '<span class="block text-xl leading-none">+</span>'; marker.querySelector('.marker-icon')?.addEventListener('load', (event) => normalizeMarkerIcon(event.currentTarget), { once: true }); marker.addEventListener('click', (event) => { event.stopPropagation(); openDialog(`<div class="flex gap-3">${type.symbolIcon ? `<img src="${escapeHtml(type.symbolIcon)}" class="h-14 w-14 rounded-lg object-cover" alt="" />` : ''}<div><h2 class="text-xl font-bold">${escapeHtml(text(type.name))}</h2><p class="mt-2 text-sm text-slate-300">${escapeHtml(text(type.description))}</p></div></div>`); }); markers.append(marker); }); const settleMap = () => { requestAnimationFrame(() => requestAnimationFrame(() => { panzoom.reset({ animate: false }); updateMarkerScale(1); requestAnimationFrame(constrainPan); })); }; image.onload = settleMap; image.onerror = settleMap; if (image.src !== new URL(map.imageUrl || '', location.href).href) image.src = map.imageUrl || ''; else if (image.complete) settleMap(); };
  if (maps.length) { const scene = document.getElementById('scene'); const viewer = document.getElementById('viewer'); let constraining = false; let constraintFrame = 0; const scheduleConstrain = () => { cancelAnimationFrame(constraintFrame); constraintFrame = requestAnimationFrame(() => { constraintFrame = requestAnimationFrame(() => { constraintFrame = 0; constrainPan(); }); }); }; constrainPan = () => { if (constraining) return; const viewerRect = viewer.getBoundingClientRect(); const sceneRect = scene.getBoundingClientRect(); let moveX = 0; let moveY = 0; if (sceneRect.width <= viewerRect.width) moveX = viewerRect.left + (viewerRect.width - sceneRect.width) / 2 - sceneRect.left; else if (sceneRect.left > viewerRect.left) moveX = viewerRect.left - sceneRect.left; else if (sceneRect.right < viewerRect.right) moveX = viewerRect.right - sceneRect.right; if (sceneRect.height <= viewerRect.height) moveY = viewerRect.top + (viewerRect.height - sceneRect.height) / 2 - sceneRect.top; else if (sceneRect.top > viewerRect.top) moveY = viewerRect.top - sceneRect.top; else if (sceneRect.bottom < viewerRect.bottom) moveY = viewerRect.bottom - sceneRect.bottom; if (Math.abs(moveX) > .5 || Math.abs(moveY) > .5) { constraining = true; const pan = panzoom.getPan(); const scale = panzoom.getScale(); panzoom.pan(pan.x + moveX / scale, pan.y + moveY / scale, { animate: true, duration: 180, easing: 'ease-out', force: true }); window.setTimeout(() => { constraining = false; scheduleConstrain(); }, 200); } }; panzoom = Panzoom(scene, { maxScale: 12, minScale: 1, step: 0.75, animate: false, duration: 0, easing: 'linear', disablePan: false }); focusEventType = (eventTypeId) => { const activeMap = maps.find((entry) => entry.mapId === document.getElementById('mapSelect').value) || maps[0]; const event = (activeMap.placedEvents || []).find((entry) => entry.eventTypeId === eventTypeId); if (!event) return; const sceneRect = scene.getBoundingClientRect(); const viewerRect = viewer.getBoundingClientRect(); const targetX = sceneRect.left + sceneRect.width * event.xPercent / 100; const targetY = sceneRect.top + sceneRect.height * event.yPercent / 100; const pan = panzoom.getPan(); const scale = panzoom.getScale(); panzoom.pan(pan.x + (viewerRect.left + viewerRect.width / 2 - targetX) / scale, pan.y + (viewerRect.top + viewerRect.height / 2 - targetY) / scale, { animate: true, duration: 240, easing: 'ease-out', force: true }); dialog.classList.replace('flex', 'hidden'); }; scene.addEventListener('panzoomchange', (event) => updateMarkerScale(event.detail.scale)); scene.addEventListener('panzoomend', scheduleConstrain); new ResizeObserver(scheduleConstrain).observe(viewer); viewer.addEventListener('wheel', panzoom.zoomWithWheel, { passive: false }); document.getElementById('mapSelect').addEventListener('change', (event) => renderMap(event.target.value)); document.getElementById('language').addEventListener('change', (event) => location.href = `/map?lang=${encodeURIComponent(event.target.value)}`); document.getElementById('legendButton').addEventListener('click', () => { const activeMap = maps.find((entry) => entry.mapId === document.getElementById('mapSelect').value) || maps[0]; const items = (activeMap.legend || []).slice().sort((left, right) => left.order - right.order).map((item) => { const type = typeById[item.eventTypeId]; if (!type) return ''; const icon = item.symbolIcon || type.symbolIcon; const category = categoryFor(type); return `<button type="button" class="legend-marker-link flex w-full items-center gap-3 rounded p-2 text-left hover:bg-slate-800" data-event-type-id="${escapeHtml(item.eventTypeId)}">${icon ? `<img src="${escapeHtml(icon)}" class="h-10 w-10 rounded-full border-[3px] object-cover" style="border-color:${escapeHtml(categoryColor(type))}" alt="" />` : `<span class="flex h-10 w-10 items-center justify-center rounded-full border-[3px]" style="border-color:${escapeHtml(categoryColor(type))}">+</span>`}<span class="min-w-0"><span class="block font-medium">${escapeHtml(text(item.customName) || text(type.name))}</span>${category ? `<span class="mt-0.5 block text-xs text-slate-400">${escapeHtml(text(category.name))}</span>` : ''}</span></button>`; }).join(''); openDialog(`<h2 class="text-xl font-bold"><%= copy.legend %></h2><div class="mt-4 space-y-3">${items}</div>`); }); renderMap(maps[0].mapId); }
  document.getElementById('closeDialog').addEventListener('click', () => dialog.classList.replace('flex', 'hidden'));
  document.getElementById('dialogContent').addEventListener('click', (event) => { const button = event.target.closest('.legend-marker-link'); if (button) focusEventType(button.dataset.eventTypeId); });
</script></body></html>