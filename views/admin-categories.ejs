<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Categories</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>body { background: #0b1220; color: #e2e8f0; }</style>
</head>
<body class="min-h-screen antialiased">
  <main class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-6 flex items-center justify-between gap-4">
      <div><a href="/admin" class="text-sm text-sky-400">Settings</a><h1 class="mt-1 text-3xl font-bold text-white">Categories</h1></div>
      <button id="openCreateModal" class="rounded-lg bg-sky-400 px-4 py-2.5 font-bold text-slate-950">Add Category</button>
    </header>

    <section class="space-y-3">
      <% if (!categories.length) { %><p class="rounded-xl border border-dashed border-slate-600 p-5 text-slate-300">No categories have been created.</p><% } %>
      <% categories.forEach((category) => { %>
        <article class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-700 bg-slate-900 p-4 shadow-lg">
          <div class="flex min-w-0 items-center gap-3">
            <% if (category.image) { %><img src="<%= category.image %>" alt="" class="h-14 w-14 rounded-lg object-cover" /><% } else { %><div class="flex h-14 w-14 items-center justify-center rounded-lg bg-slate-800 text-xs">IMG</div><% } %>
            <div><h2 class="font-bold text-white"><%= category.name.en || category.name.ru || category.name.ro || 'Untitled category' %></h2><p class="mt-1 text-xs text-slate-400">ID: <%= category.categoryId %> | Order: <%= category.order %></p></div>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="edit-category rounded-lg border border-slate-500 px-3 py-2 text-sm font-semibold" data-id="<%= category.categoryId %>" data-name-en="<%= category.name.en || '' %>" data-name-ru="<%= category.name.ru || '' %>" data-name-ro="<%= category.name.ro || '' %>" data-order="<%= category.order %>">Edit</button>
            <a href="/admin/categories/<%= encodeURIComponent(category.categoryId) %>/candidates" class="rounded-lg bg-sky-400 px-3 py-2 text-sm font-bold text-slate-950">Manage Candidates</a>
            <form method="POST" action="/admin/categories/<%= encodeURIComponent(category.categoryId) %>/delete" onsubmit="return confirm('Delete this category and all of its candidates?');"><button class="rounded-lg border border-red-500/50 px-3 py-2 text-sm font-semibold text-red-200">Delete</button></form>
          </div>
        </article>
      <% }) %>
    </section>
  </main>

  <div id="createModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/75 p-4">
    <form method="POST" action="/admin/categories" enctype="multipart/form-data" class="w-full max-w-lg rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <div class="flex items-center justify-between"><h2 class="text-xl font-bold text-white">Add category</h2><button type="button" data-close-modal="createModal" class="text-slate-300">Close</button></div>
      <div class="mt-5 grid gap-3">
        <label class="text-sm">Category image<input type="file" name="image" accept="image/*" class="mt-1 block w-full text-sm" /></label>
        <label class="text-sm">Name (English)<input name="nameEn" required class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Name (Russian)<input name="nameRu" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Name (Romanian)<input name="nameRo" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Order position (optional)<input name="order" type="number" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <button class="mt-2 rounded-lg bg-emerald-400 px-4 py-2.5 font-bold text-slate-950">Create category</button>
      </div>
    </form>
  </div>

  <div id="editModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/75 p-4">
    <form id="editCategoryForm" method="POST" enctype="multipart/form-data" class="w-full max-w-lg rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <div class="flex items-center justify-between"><h2 class="text-xl font-bold text-white">Edit category</h2><button type="button" data-close-modal="editModal" class="text-slate-300">Close</button></div>
      <p id="editCategoryId" class="mt-2 text-sm text-slate-400"></p>
      <div class="mt-5 grid gap-3">
        <label class="text-sm">Replace category image<input type="file" name="image" accept="image/*" class="mt-1 block w-full text-sm" /></label>
        <label class="text-sm">Name (English)<input id="editNameEn" name="nameEn" required class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Name (Russian)<input id="editNameRu" name="nameRu" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Name (Romanian)<input id="editNameRo" name="nameRo" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Order position<input id="editOrder" name="order" type="number" required class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <button class="mt-2 rounded-lg bg-emerald-400 px-4 py-2.5 font-bold text-slate-950">Save category</button>
      </div>
    </form>
  </div>

  <script>
    const showModal = (id) => document.getElementById(id).classList.replace('hidden', 'flex');
    const hideModal = (id) => document.getElementById(id).classList.replace('flex', 'hidden');
    const adminToken = () => sessionStorage.getItem('adminBearerToken');
    const submitAdminForm = async (form) => {
      if (!adminToken()) { window.location.href = '/admin/login'; return; }
      const response = await fetch(form.action, { method: form.method || 'POST', headers: { Authorization: `Bearer ${adminToken()}` }, body: new FormData(form) });
      const result = await response.json();
      if (!response.ok || !result.success) throw new Error(result.error || 'Request failed.');
      window.location.href = result.redirect || '/admin/categories';
    };
    document.getElementById('openCreateModal').onclick = () => showModal('createModal');
    document.querySelectorAll('[data-close-modal]').forEach((button) => button.onclick = () => hideModal(button.dataset.closeModal));
    document.querySelectorAll('.edit-category').forEach((button) => button.onclick = () => {
      document.getElementById('editCategoryForm').action = `/admin/categories/${encodeURIComponent(button.dataset.id)}/update`;
      document.getElementById('editCategoryId').textContent = `Category ID: ${button.dataset.id}`;
      document.getElementById('editNameEn').value = button.dataset.nameEn;
      document.getElementById('editNameRu').value = button.dataset.nameRu;
      document.getElementById('editNameRo').value = button.dataset.nameRo;
      document.getElementById('editOrder').value = button.dataset.order;
      showModal('editModal');
    });
    document.querySelectorAll('form').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); submitAdminForm(form).catch((error) => window.alert(error.message)); }));
  </script>
</body>
</html>