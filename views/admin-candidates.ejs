<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Candidates</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>body { background: #0b1220; color: #e2e8f0; }</style>
</head>
<body class="min-h-screen antialiased">
  <main class="mx-auto max-w-4xl px-4 py-8">
    <header class="mb-6 flex items-center justify-between gap-4">
      <div><a href="/admin/categories" class="text-sm text-sky-400">Categories</a><h1 class="mt-1 text-3xl font-bold text-white"><%= category.name.en || category.name.ru || category.name.ro || 'Category' %></h1><p class="mt-1 text-sm text-slate-400">Category ID: <%= category.categoryId %></p></div>
      <button id="openCreateModal" class="rounded-lg bg-sky-400 px-4 py-2.5 font-bold text-slate-950">Add Candidate</button>
    </header>

    <section class="space-y-3">
      <% if (!candidates.length) { %><p class="rounded-xl border border-dashed border-slate-600 p-5 text-slate-300">No candidates have been created.</p><% } %>
      <% candidates.forEach((candidate) => { %>
        <article class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-slate-700 bg-slate-900 p-4">
          <div class="flex min-w-0 items-center gap-3">
            <% if (candidate.image) { %><img src="<%= candidate.image %>" alt="" class="h-14 w-14 rounded-lg object-cover" /><% } else { %><div class="flex h-14 w-14 items-center justify-center rounded-lg bg-slate-800 text-xs">IMG</div><% } %>
            <div><h2 class="font-bold text-white"><%= candidate.name %></h2><p class="mt-1 text-xs text-slate-400">ID: <%= candidate.candidateId %><% if (candidate.code) { %> | <%= candidate.code %><% } %></p><p class="mt-1 text-sm text-slate-300"><%= candidate.description %></p></div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <button type="button" class="edit-candidate rounded-lg border border-slate-500 px-3 py-2 text-sm font-semibold" data-id="<%= candidate.candidateId %>" data-name="<%= candidate.name %>" data-description="<%= candidate.description || '' %>" data-code="<%= candidate.code || '' %>" data-video-url="<%= candidate.videoUrl || '' %>" data-order="<%= candidate.order %>">Edit</button>
            <form method="POST" action="/admin/categories/<%= encodeURIComponent(category.categoryId) %>/candidates/<%= encodeURIComponent(candidate.candidateId) %>/order" class="flex gap-1"><input type="number" name="order" value="<%= candidate.order %>" aria-label="Candidate order" class="w-20 rounded-lg border border-slate-600 bg-slate-800 px-2 py-2 text-sm text-white" /><button class="rounded-lg border border-slate-500 px-2 py-2 text-sm">Save order</button></form>
            <form method="POST" action="/admin/categories/<%= encodeURIComponent(category.categoryId) %>/candidates/<%= encodeURIComponent(candidate.candidateId) %>/delete" onsubmit="return confirm('Delete this candidate?');"><button class="rounded-lg border border-red-500/50 px-3 py-2 text-sm font-semibold text-red-200">Delete</button></form>
          </div>
        </article>
      <% }) %>
    </section>
  </main>

  <div id="createModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/75 p-4">
    <form method="POST" action="/admin/categories/<%= encodeURIComponent(category.categoryId) %>/candidates" enctype="multipart/form-data" class="w-full max-w-lg rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <div class="flex items-center justify-between"><h2 class="text-xl font-bold text-white">Add candidate</h2><button type="button" data-close-modal="createModal" class="text-slate-300">Close</button></div>
      <div class="mt-5 grid gap-3">
        <label class="text-sm">Candidate photo<input type="file" name="image" accept=".jpg,.jpeg,.png,.webp" class="candidate-image-input mt-1 block w-full text-sm" /></label>
        <label class="text-sm">Candidate name<input name="name" required class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Description<textarea name="description" rows="3" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"></textarea></label>
        <label class="text-sm">Candidate code<input name="code" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <% if (category.requiresVideoUrl) { %><label class="text-sm">Participant Video URL<input name="videoUrl" type="url" required placeholder="https://..." class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><% } %>
        <label class="text-sm">Order position (optional)<input name="order" type="number" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <button class="mt-2 rounded-lg bg-emerald-400 px-4 py-2.5 font-bold text-slate-950">Create candidate</button>
      </div>
    </form>
  </div>

  <div id="editModal" class="fixed inset-0 hidden items-center justify-center bg-slate-950/75 p-4">
    <form id="editCandidateForm" method="POST" enctype="multipart/form-data" class="w-full max-w-lg rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <div class="flex items-center justify-between"><h2 class="text-xl font-bold text-white">Edit candidate</h2><button type="button" data-close-modal="editModal" class="text-slate-300">Close</button></div>
      <p id="editCandidateId" class="mt-2 text-sm text-slate-400"></p>
      <div class="mt-5 grid gap-3">
        <label class="text-sm">Replace candidate photo<input type="file" name="image" accept=".jpg,.jpeg,.png,.webp" class="candidate-image-input mt-1 block w-full text-sm" /></label>
        <label class="text-sm">Candidate name<input id="editName" name="name" required class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <label class="text-sm">Description<textarea id="editDescription" name="description" rows="3" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"></textarea></label>
        <label class="text-sm">Candidate code<input id="editCode" name="code" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <% if (category.requiresVideoUrl) { %><label class="text-sm">Participant Video URL<input id="editVideoUrl" name="videoUrl" type="url" required placeholder="https://..." class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><% } %>
        <label class="text-sm">Order position<input id="editOrder" name="order" type="number" required class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label>
        <button class="mt-2 rounded-lg bg-emerald-400 px-4 py-2.5 font-bold text-slate-950">Save candidate</button>
      </div>
    </form>
  </div>

  <script>
    const categoryId = '<%= category.categoryId %>';
    const maxCandidateImageBytes = 25 * 1024 * 1024;
    const showModal = (id) => document.getElementById(id).classList.replace('hidden', 'flex');
    const hideModal = (id) => document.getElementById(id).classList.replace('flex', 'hidden');
    const adminToken = () => sessionStorage.getItem('adminBearerToken');
    const submitAdminForm = async (form) => {
      if (!adminToken()) { window.location.href = '/admin/login'; return; }
      const response = await fetch(form.action, { method: form.method || 'POST', headers: { Authorization: `Bearer ${adminToken()}` }, body: new FormData(form) });
      const result = await response.json().catch(() => ({}));
      if (response.status === 413 || result.code === 'FILE_TOO_LARGE') throw new Error(<%- JSON.stringify(t.candidateFileTooLarge) %>);
      if (response.status === 415 || result.code === 'UNSUPPORTED_IMAGE_FORMAT') throw new Error(<%- JSON.stringify(t.unsupportedFileFormat) %>);
      if (!response.ok || !result.success) throw new Error(result.error || 'Request failed.');
      window.location.href = result.redirect || `/admin/categories/${encodeURIComponent(categoryId)}/candidates`;
    };
    document.getElementById('openCreateModal').onclick = () => showModal('createModal');
    document.querySelectorAll('[data-close-modal]').forEach((button) => button.onclick = () => hideModal(button.dataset.closeModal));
    const validateCandidateImage = (input) => {
      if (!input.files.length || input.files[0].size <= maxCandidateImageBytes) return true;
      input.value = '';
      window.alert(<%- JSON.stringify(t.candidateFileTooLarge) %>);
      return false;
    };
    document.querySelectorAll('.candidate-image-input').forEach((input) => input.addEventListener('change', () => validateCandidateImage(input)));
    document.querySelectorAll('.edit-candidate').forEach((button) => button.onclick = () => {
      document.getElementById('editCandidateForm').action = `/admin/categories/${encodeURIComponent(categoryId)}/candidates/${encodeURIComponent(button.dataset.id)}/update`;
      document.getElementById('editCandidateId').textContent = `Candidate ID: ${button.dataset.id}`;
      document.getElementById('editName').value = button.dataset.name;
      document.getElementById('editDescription').value = button.dataset.description;
      document.getElementById('editCode').value = button.dataset.code;
      const editVideoUrl = document.getElementById('editVideoUrl'); if (editVideoUrl) editVideoUrl.value = button.dataset.videoUrl;
      document.getElementById('editOrder').value = button.dataset.order;
      showModal('editModal');
    });
    document.querySelectorAll('form').forEach((form) => form.addEventListener('submit', (event) => { event.preventDefault(); const imageInput = form.querySelector('.candidate-image-input'); if (imageInput && !validateCandidateImage(imageInput)) return; submitAdminForm(form).catch((error) => window.alert(error.message)); }));
  </script>
</body>
</html>