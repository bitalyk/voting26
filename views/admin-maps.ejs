<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Maps</title><script src="https://cdn.tailwindcss.com"></script><style>body{background:#0b1220;color:#e2e8f0}</style></head><body><main class="mx-auto max-w-4xl p-4"><header class="mb-6 flex justify-between"><div><a href="/admin" class="text-sky-300">Settings</a><h1 class="text-3xl font-bold">Interactive Maps</h1></div><button id="create" class="rounded-lg bg-sky-400 px-4 py-2 font-bold text-slate-950">Create New Map</button></header><div class="space-y-3"><% if(!maps.length){ %><p class="rounded-lg border border-dashed border-slate-600 p-5">No maps created.</p><% } %><% maps.forEach(map=>{ %><article class="flex items-center justify-between gap-3 rounded-lg border border-slate-700 bg-slate-900 p-3"><div class="flex items-center gap-3"><% if(map.imageUrl){ %><img src="<%= map.imageUrl %>" class="h-14 w-20 rounded object-cover" alt=""><% } %><div><b><%= (map.name&& (map.name.en||map.name.ru||map.name.ro))||'Untitled map' %></b><div class="mt-1 flex items-center gap-2"><p class="text-xs text-slate-400"><%= new Date(map.createdAt).toLocaleDateString() %></p><span class="rounded px-2 py-0.5 text-xs font-medium <%= map.isVisible !== false ? 'bg-emerald-400/15 text-emerald-300' : 'bg-slate-700 text-slate-300' %>"><%= map.isVisible !== false ? 'Public' : 'Hidden' %></span><% if(map.isDefault){ %><span class="rounded bg-sky-400/15 px-2 py-0.5 text-xs font-medium text-sky-300">Default</span><% } %></div></div></div><div class="flex gap-2"><a class="rounded border border-slate-500 px-3 py-2" href="/admin/interactive-map/edit?mapId=<%= map.mapId %>">Edit</a><button class="delete rounded border border-red-500 px-3 py-2 text-red-200" data-id="<%= map.mapId %>">Delete</button></div></article><% }) %></div></main><script>const token=()=>sessionStorage.getItem('adminBearerToken');async function api(url,opt={}){const r=await fetch(url,{...opt,headers:{...(opt.headers||{}),Authorization:'Bearer '+token()}}),j=await r.json();if(!r.ok||!j.success)throw Error(j.error||'Request failed');return j}document.getElementById('create').onclick=async()=>{try{location.href=(await api('/api/admin/maps',{method:'POST'})).redirect}catch(e){alert(e.message)}};document.querySelectorAll('.delete').forEach(b=>b.onclick=async()=>{if(!confirm('Delete this map and its placed events?'))return;try{location.href=(await api('/api/admin/maps/'+encodeURIComponent(b.dataset.id)+'/delete',{method:'POST'})).redirect}catch(e){alert(e.message)}})</script></body></html>