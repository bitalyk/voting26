<% const errorLanguage = ['en', 'ru', 'ro'].includes(typeof lang === 'string' ? lang : '') ? lang : 'en'; %>
<% const errorText = { en: { title: 'Access denied', notice: 'Notice', leaderboard: 'View Leaderboard', language: 'Language' }, ru: { title: 'Доступ запрещён', notice: 'Уведомление', leaderboard: 'Открыть лидерборд', language: 'Язык' }, ro: { title: 'Acces interzis', notice: 'Notificare', leaderboard: 'Vezi clasamentul', language: 'Limbă' } }[errorLanguage]; %>
<!DOCTYPE html>
<html lang="<%= errorLanguage %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= errorText.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex min-h-screen items-center justify-center bg-slate-950 p-4 text-slate-100">
    <div class="w-full max-w-sm rounded-2xl border border-slate-700 bg-slate-900 p-6 text-center shadow-2xl">
        <div class="mb-5 flex justify-end"><select id="languageSwitcher" aria-label="<%= errorText.language %>" class="rounded-full border border-slate-600 bg-slate-800 px-2 py-1 text-xs font-medium text-slate-200 outline-none"><option value="en" <%= errorLanguage === 'en' ? 'selected' : '' %>>EN</option><option value="ru" <%= errorLanguage === 'ru' ? 'selected' : '' %>>RU</option><option value="ro" <%= errorLanguage === 'ro' ? 'selected' : '' %>>RO</option></select></div>
        <h1 class="text-xl font-bold text-red-300"><%= errorText.notice %></h1>
        <p class="mt-3 text-sm text-slate-300"><%= message %></p>
        <a href="/leaderboard?lang=<%= errorLanguage %>" class="mt-5 inline-block text-sm font-semibold text-sky-300 underline"><%= errorText.leaderboard %></a>
    </div>
    <script>document.getElementById('languageSwitcher').addEventListener('change', (event) => { const url = new URL(window.location.href); url.searchParams.set('lang', event.target.value); window.location.href = url.toString(); });</script>
</body>
</html>