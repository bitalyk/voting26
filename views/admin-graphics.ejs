<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Site Graphics</title><script src="https://cdn.tailwindcss.com"></script><script>sessionStorage.setItem('adminBearerToken', sessionStorage.getItem('adminBearerToken') || 'session');</script><style>body{background:#0b1220;color:#e2e8f0}</style></head>
<body class="min-h-screen antialiased"><main class="mx-auto max-w-2xl px-4 py-8"><header class="mb-6"><a href="/admin" class="text-sm text-sky-400">Settings</a><h1 class="mt-1 text-3xl font-bold text-white">Site Graphics</h1><p class="mt-1 text-sm text-slate-400">Upload the favicon used across the GoCon site.</p></header><section class="rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-xl"><% if (siteConfig.faviconPath) { %><div class="mb-5 flex items-center gap-4 rounded-lg border border-slate-700 bg-slate-800 p-4"><img src="/favicon.ico" alt="Active favicon" class="h-12 w-12 rounded-lg bg-white p-1 object-contain" /><p class="min-w-0 break-all text-sm text-slate-300">Active file: <%= siteConfig.faviconPath %></p></div><% } %><form method="POST" action="/admin/graphics/favicon" enctype="multipart/form-data" class="space-y-4"><label class="block text-sm font-medium">Favicon file<input name="favicon" type="file" required accept=".jpg,.jpeg,.png,.gif,.webp,.svg" class="mt-2 block w-full text-sm text-slate-300" /></label><p class="text-xs text-slate-400">PNG, JPG, GIF, WEBP, or SVG. Maximum file size: 5 MB.</p><button class="rounded-lg bg-fuchsia-400 px-4 py-2.5 font-bold text-slate-950">Upload favicon</button></form></section></main><script>const form=document.querySelector('form');form.addEventListener('submit',async(event)=>{event.preventDefault();const token=sessionStorage.getItem('adminBearerToken');if(!token){location.href='/admin/login';return}const response=await fetch(form.action,{method:'POST',headers:{Authorization:`Bearer ${token}`},body:new FormData(form)});const result=await response.json().catch(()=>({}));if(response.status===413||result.code==='FILE_TOO_LARGE'){alert(<%- JSON.stringify(t.fileTooLarge) %>);return}if(response.status===415||result.code==='UNSUPPORTED_IMAGE_FORMAT'){alert(<%- JSON.stringify(t.unsupportedFileFormat) %>);return}if(!response.ok||!result.success){alert(result.error||'Upload failed.');return}location.href=result.redirect;});</script></body>
</html>