<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Site Graphics</title><script src="https://cdn.tailwindcss.com"></script><script>sessionStorage.setItem('adminBearerToken', sessionStorage.getItem('adminBearerToken') || 'session');</script><style>body{background:#0b1220;color:#e2e8f0}</style></head>
<body class="min-h-screen antialiased">
	<main class="mx-auto max-w-2xl px-4 py-8">
		<header class="mb-6"><a href="/admin" class="text-sm text-sky-400">Settings</a><h1 class="mt-1 text-3xl font-bold text-white">Site Graphics</h1><p class="mt-1 text-sm text-slate-400">Manage the public favicon and visual theme. Admin screens keep their default Tailwind styling.</p></header>
		<section class="rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-xl">
			<% if (siteConfig.faviconPath) { %><div class="mb-5 flex items-center gap-4 rounded-lg border border-slate-700 bg-slate-800 p-4"><img src="/favicon.ico" alt="Active favicon" class="h-12 w-12 rounded-lg bg-white p-1 object-contain" /><p class="min-w-0 break-all text-sm text-slate-300">Active file: <%= siteConfig.faviconPath %></p></div><% } %>
			<form id="faviconForm" method="POST" action="/admin/graphics/favicon" enctype="multipart/form-data" class="space-y-4"><label class="block text-sm font-medium">Favicon file<input name="favicon" type="file" required accept=".jpg,.jpeg,.png,.gif,.webp,.svg" class="mt-2 block w-full text-sm text-slate-300" /></label><p class="text-xs text-slate-400">PNG, JPG, GIF, WEBP, or SVG. Maximum file size: 5 MB.</p><button class="rounded-lg bg-fuchsia-400 px-4 py-2.5 font-bold text-slate-950">Upload favicon</button></form>
		</section>

		<% const publicTheme = siteConfig.publicTheme || 'classic'; const themes = [{ id: 'classic', name: 'Classic', description: 'Original GoCon interface', colors: ['#0f172a', '#38bdf8', '#ffffff'] }, { id: 'studio', name: 'Studio', description: 'Clean editorial festival look', colors: ['#f5f6f8', '#087f8c', '#df3f73'] }, { id: 'night', name: 'Night Pulse', description: 'Dark event mode with neon accents', colors: ['#111319', '#62d9d0', '#ff4f8b'] }, { id: 'citrus', name: 'Citrus Pop', description: 'Warm playful daytime palette', colors: ['#fffaf1', '#234a45', '#e95836'] }]; %>
		<section class="mt-6 rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-xl">
			<div><h2 class="text-xl font-bold text-white">Public Theme</h2><p class="mt-1 text-sm text-slate-400">Applied to the public site only. Changes take effect on the next page load.</p></div>
			<form id="themeForm" method="POST" action="/admin/graphics/theme" class="mt-5">
				<div class="grid gap-3 sm:grid-cols-2">
					<% themes.forEach((theme) => { %>
						<label class="cursor-pointer rounded-lg border p-4 transition <%= publicTheme === theme.id ? 'border-sky-400 bg-sky-400/10' : 'border-slate-700 bg-slate-800 hover:border-slate-500' %>">
							<input class="sr-only" type="radio" name="publicTheme" value="<%= theme.id %>" <%= publicTheme === theme.id ? 'checked' : '' %> />
							<span class="flex items-start justify-between gap-3"><span><span class="block font-bold text-white"><%= theme.name %></span><span class="mt-1 block text-xs text-slate-400"><%= theme.description %></span></span><span class="flex shrink-0 gap-1"><% theme.colors.forEach((color) => { %><span class="h-4 w-4 rounded-full border border-white/20" style="background:<%= color %>"></span><% }) %></span></span>
						</label>
					<% }) %>
				</div>
				<button class="mt-5 rounded-lg bg-sky-400 px-4 py-2.5 font-bold text-slate-950">Save Public Theme</button>
			</form>
		</section>
	</main>
	<script>
		const submitGraphicsForm = async (form, options = {}) => {
			const token = sessionStorage.getItem('adminBearerToken');
			if (!token) { location.href = '/admin/login'; return; }
			const response = await fetch(form.action, { method: 'POST', headers: { Authorization: `Bearer ${token}`, ...(options.headers || {}) }, body: options.body || new FormData(form) });
			const result = await response.json().catch(() => ({}));
			if (response.status === 413 || result.code === 'FILE_TOO_LARGE') throw new Error(<%- JSON.stringify(t.fileTooLarge) %>);
			if (response.status === 415 || result.code === 'UNSUPPORTED_IMAGE_FORMAT') throw new Error(<%- JSON.stringify(t.unsupportedFileFormat) %>);
			if (!response.ok || !result.success) throw new Error(result.error || 'Save failed.');
			location.href = result.redirect || '/admin/graphics';
		};
		document.getElementById('faviconForm').addEventListener('submit', (event) => { event.preventDefault(); submitGraphicsForm(event.currentTarget).catch((error) => alert(error.message)); });
		document.getElementById('themeForm').addEventListener('submit', (event) => { event.preventDefault(); const form = event.currentTarget; submitGraphicsForm(form, { headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' }, body: new URLSearchParams(new FormData(form)) }).catch((error) => alert(error.message)); });
	</script>
</body>
</html>