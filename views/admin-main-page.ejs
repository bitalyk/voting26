<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Main Page CMS</title><script src="https://cdn.tailwindcss.com"></script><script>sessionStorage.setItem('adminBearerToken', sessionStorage.getItem('adminBearerToken') || 'session');</script><style>body{background:#0b1220;color:#e2e8f0}</style></head>
<body class="min-h-screen antialiased"><main class="mx-auto max-w-5xl px-4 py-8"><header class="mb-6 flex flex-wrap items-end justify-between gap-4"><div><a href="/admin" class="text-sm text-sky-400">Settings</a><h1 class="mt-1 text-3xl font-bold text-white">Main Page CMS</h1><p class="mt-1 text-sm text-slate-400">Control visibility and localized copy for every home-page panel.</p></div><a href="/admin/main-page/order" class="rounded-lg border border-cyan-400 px-4 py-2.5 font-bold text-cyan-200">Manage Panels Order</a></header><form method="POST" action="/admin/main-page" class="space-y-4"><% siteConfig.mainPageLayout.slice().sort((a,b)=>a.order-b.order).forEach((panel)=>{ %><article class="rounded-xl border border-slate-700 bg-slate-900 p-5 shadow-lg"><div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-lg font-bold text-white"><%= panel.panelId %></h2><label class="flex items-center gap-2 text-sm text-slate-200">Visible <input name="visible_<%= panel.panelId %>" type="checkbox" <%= panel.visible ? 'checked' : '' %> class="h-4 w-4 accent-cyan-400" /></label></div><input name="order_<%= panel.panelId %>" type="hidden" value="<%= panel.order %>" /><div class="mt-4 grid gap-3 md:grid-cols-3"><label class="text-sm">Title (EN)<input name="<%= panel.panelId %>TitleEn" value="<%= panel.title.en || '' %>" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><label class="text-sm">Title (RU)<input name="<%= panel.panelId %>TitleRu" value="<%= panel.title.ru || '' %>" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><label class="text-sm">Title (RO)<input name="<%= panel.panelId %>TitleRo" value="<%= panel.title.ro || '' %>" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white" /></label><label class="text-sm md:col-span-3">Description (EN)<textarea name="<%= panel.panelId %>DescriptionEn" rows="2" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"><%= panel.description.en || '' %></textarea></label><label class="text-sm md:col-span-3">Description (RU)<textarea name="<%= panel.panelId %>DescriptionRu" rows="2" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"><%= panel.description.ru || '' %></textarea></label><label class="text-sm md:col-span-3">Description (RO)<textarea name="<%= panel.panelId %>DescriptionRo" rows="2" class="mt-1 w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-white"><%= panel.description.ro || '' %></textarea></label></div></article><% }) %><button class="rounded-lg bg-emerald-400 px-5 py-3 font-bold text-slate-950">Save Main Page</button></form></main><script>document.querySelector('form').addEventListener('submit',async(event)=>{event.preventDefault();const token=sessionStorage.getItem('adminBearerToken');if(!token){location.href='/admin/login';return}const form=event.currentTarget;const response=await fetch(form.action,{method:'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:new URLSearchParams(new FormData(form))});const result=await response.json();if(!response.ok||!result.success){alert(result.error||'Save failed.');return}location.href=result.redirect;});</script></body>
</html>