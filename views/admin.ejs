<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body {
      background: linear-gradient(180deg, #020617 0%, #0f172a 100%);
      color: #e2e8f0;
    }
  </style>
</head>
<body class="min-h-screen antialiased">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <% if (!isLoggedIn) { %>
      <div class="mx-auto max-w-md rounded-3xl border border-slate-700 bg-slate-900/80 p-6 shadow-2xl shadow-slate-950/30">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">Admin</p>
        <h1 class="mt-2 text-3xl font-black text-white"><%= t.login %></h1>

        <% if (errorMessage) { %>
          <div class="mt-4 rounded-xl border border-red-500/40 bg-red-500/10 px-3 py-2 text-sm text-red-200"><%= errorMessage %></div>
        <% } %>

        <form method="POST" action="/admin/login" class="mt-6 space-y-4">
          <div>
            <label for="password" class="mb-2 block text-sm font-medium text-slate-200"><%= t.password %></label>
            <input id="password" name="password" type="password" required class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
          </div>
          <button type="submit" class="w-full rounded-2xl bg-sky-500 px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-sky-500/20">Login</button>
        </form>
      </div>
    <% } else { %>
      <div class="mb-6 flex items-center justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-400">Dashboard</p>
          <h1 class="mt-1 text-3xl font-black text-white">Administration Panel</h1>
        </div>
        <form method="POST" action="/admin/logout">
          <button type="submit" class="rounded-2xl border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-semibold text-slate-100">Logout</button>
        </form>
      </div>

      <div class="grid gap-6 lg:grid-cols-2">
        <section class="rounded-3xl border border-slate-700 bg-slate-900/80 p-5 shadow-xl shadow-slate-950/30">
          <h2 class="text-xl font-bold text-white">Global Settings</h2>
          <form method="POST" action="/admin/settings" class="mt-4 space-y-4">
            <label class="flex items-center justify-between rounded-2xl border border-slate-700 bg-slate-800/80 px-3 py-3 text-sm text-slate-200">
              <span>Allow Test Voting</span>
              <input type="checkbox" name="allowTestVoting" <%= settings.allowTestVoting ? 'checked' : '' %> class="h-4 w-4 accent-sky-500" />
            </label>

            <label class="flex items-center justify-between rounded-2xl border border-slate-700 bg-slate-800/80 px-3 py-3 text-sm text-slate-200">
              <span>Show Soon Text</span>
              <input type="checkbox" name="showSoonText" <%= settings.showSoonText ? 'checked' : '' %> class="h-4 w-4 accent-sky-500" />
            </label>

            <label class="flex items-center justify-between rounded-2xl border border-slate-700 bg-slate-800/80 px-3 py-3 text-sm text-slate-200">
              <span>Allow Test Leaderboard</span>
              <input type="checkbox" name="allowTestLeaderboard" <%= settings.allowTestLeaderboard ? 'checked' : '' %> class="h-4 w-4 accent-sky-500" />
            </label>

            <div>
              <label class="mb-2 block text-sm text-slate-200">Voting Start Timestamp</label>
              <input type="datetime-local" name="votingStartTimestamp" value="<%= settings.votingStartTimestamp ? new Date(settings.votingStartTimestamp).toISOString().slice(0,16) : '' %>" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>

            <div>
              <label class="mb-2 block text-sm text-slate-200">Leaderboard Show Timestamp</label>
              <input type="datetime-local" name="leaderboardShowTimestamp" value="<%= settings.leaderboardShowTimestamp ? new Date(settings.leaderboardShowTimestamp).toISOString().slice(0,16) : '' %>" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>

            <button type="submit" class="w-full rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/20">Save Settings</button>
          </form>
        </section>

        <section class="rounded-3xl border border-slate-700 bg-slate-900/80 p-5 shadow-xl shadow-slate-950/30">
          <h2 class="text-xl font-bold text-white">Category Management</h2>
          <form method="POST" action="/admin/categories" enctype="multipart/form-data" class="mt-4 space-y-4">
            <div>
              <label class="mb-2 block text-sm text-slate-200">Category Id</label>
              <input name="categoryId" type="text" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="mb-2 block text-sm text-slate-200">Name EN</label>
              <input name="nameEn" type="text" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="mb-2 block text-sm text-slate-200">Name RU</label>
              <input name="nameRu" type="text" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="mb-2 block text-sm text-slate-200">Name RO</label>
              <input name="nameRo" type="text" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="mb-2 block text-sm text-slate-200">Image URL</label>
              <input name="imageUrl" type="url" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>
            <div>
              <label class="mb-2 block text-sm text-slate-200">Upload image</label>
              <input name="image" type="file" accept="image/*" class="w-full rounded-2xl border border-dashed border-slate-600 bg-slate-800 px-3 py-3 text-sm text-slate-300" />
            </div>
            <div>
              <label class="mb-2 block text-sm text-slate-200">Order</label>
              <input name="order" type="number" min="0" class="w-full rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white outline-none focus:border-sky-500" />
            </div>
            <button type="submit" class="w-full rounded-2xl bg-sky-500 px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-sky-500/20">Add Category</button>
          </form>

          <div class="mt-6 space-y-3">
            <% categories.forEach((category) => { %>
              <div class="rounded-2xl border border-slate-700 bg-slate-800/70 p-3">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <% if (category.image) { %>
                      <img src="<%= category.image %>" alt="<%= category.name && category.name.en ? category.name.en : category.categoryId %>" class="h-12 w-12 rounded-xl object-cover border border-slate-600 bg-slate-900" />
                    <% } else { %>
                      <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-slate-600 bg-slate-900 text-xs font-bold text-slate-200">IMG</div>
                    <% } %>
                    <div>
                      <p class="font-semibold text-white"><%= category.name && category.name.en ? category.name.en : category.categoryId %></p>
                      <p class="text-xs text-slate-400">ID: <%= category.categoryId %></p>
                    </div>
                  </div>
                  <form method="POST" action="/admin/categories/<%= category.categoryId %>/delete">
                    <button type="submit" class="rounded-xl border border-red-500/40 bg-red-500/10 px-2 py-1 text-xs font-semibold text-red-200">Delete</button>
                  </form>
                </div>
                <form method="POST" action="/admin/categories/<%= category.categoryId %>/update" enctype="multipart/form-data" class="mt-3 space-y-3">
                  <input name="nameEn" type="text" value="<%= category.name && category.name.en ? category.name.en : '' %>" class="w-full rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                  <input name="nameRu" type="text" value="<%= category.name && category.name.ru ? category.name.ru : '' %>" class="w-full rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                  <input name="nameRo" type="text" value="<%= category.name && category.name.ro ? category.name.ro : '' %>" class="w-full rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                  <input name="imageUrl" type="url" value="<%= category.image || '' %>" class="w-full rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                  <input name="order" type="number" min="0" value="<%= category.order || 0 %>" class="w-full rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                  <input name="image" type="file" accept="image/*" class="w-full rounded-xl border border-dashed border-slate-600 bg-slate-900 px-2 py-2 text-xs text-slate-300" />
                  <button type="submit" class="w-full rounded-xl bg-sky-500 px-3 py-2 text-sm font-bold text-slate-950">Update</button>
                </form>
              </div>
            <% }) %>
          </div>
        </section>
      </div>

      <section class="mt-8 rounded-3xl border border-slate-700 bg-slate-900/80 p-5 shadow-xl shadow-slate-950/30">
        <h2 class="text-xl font-bold text-white">Candidate Management</h2>
        <form method="POST" action="/admin/candidates" enctype="multipart/form-data" class="mt-4 grid gap-4 md:grid-cols-2">
          <input name="candidateId" type="text" placeholder="Candidate Id" class="rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white" />
          <select name="categoryId" class="rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white">
            <% categories.forEach((category) => { %>
              <option value="<%= category.categoryId %>"><%= category.name && category.name.en ? category.name.en : category.categoryId %></option>
            <% }) %>
          </select>
          <input name="name" type="text" placeholder="Name" class="rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white" />
          <input name="code" type="text" placeholder="Code" class="rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white" />
          <input name="imageUrl" type="url" placeholder="Image URL" class="md:col-span-2 rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white" />
          <input name="image" type="file" accept="image/*" class="md:col-span-2 rounded-2xl border border-dashed border-slate-600 bg-slate-800 px-3 py-3 text-sm text-slate-300" />
          <textarea name="description" rows="3" placeholder="Description" class="md:col-span-2 rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white"></textarea>
          <input name="order" type="number" min="0" placeholder="Order" class="rounded-2xl border border-slate-600 bg-slate-800 px-3 py-3 text-white" />
          <button type="submit" class="rounded-2xl bg-emerald-500 px-4 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-emerald-500/20">Add Candidate</button>
        </form>

        <div class="mt-6 space-y-3">
          <% candidates.forEach((candidate) => { %>
            <div class="rounded-2xl border border-slate-700 bg-slate-800/70 p-3">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <p class="font-semibold text-white"><%= candidate.name %></p>
                  <p class="text-xs text-slate-400">ID: <%= candidate.candidateId %></p>
                </div>
                <form method="POST" action="/admin/candidates/<%= encodeURIComponent(candidate.candidateId) %>/<%= encodeURIComponent(candidate.categoryId) %>/delete">
                  <button type="submit" class="rounded-xl border border-red-500/40 bg-red-500/10 px-2 py-1 text-xs font-semibold text-red-200">Delete</button>
                </form>
              </div>
              <form method="POST" action="/admin/candidates/<%= encodeURIComponent(candidate.candidateId) %>/<%= encodeURIComponent(candidate.categoryId) %>/update" enctype="multipart/form-data" class="mt-3 grid gap-3 md:grid-cols-2">
                <select name="categoryId" class="rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white">
                  <% categories.forEach((category) => { %>
                    <option value="<%= category.categoryId %>" <%= candidate.categoryId === category.categoryId ? 'selected' : '' %>><%= category.name && category.name.en ? category.name.en : category.categoryId %></option>
                  <% }) %>
                </select>
                <input name="name" type="text" value="<%= candidate.name %>" class="rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                <input name="code" type="text" value="<%= candidate.code || '' %>" class="rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                <input name="order" type="number" value="<%= candidate.order || 0 %>" class="rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                <input name="imageUrl" type="url" value="<%= candidate.image || '' %>" class="md:col-span-2 rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white" />
                <input name="image" type="file" accept="image/*" class="md:col-span-2 rounded-xl border border-dashed border-slate-600 bg-slate-900 px-2 py-2 text-xs text-slate-300" />
                <textarea name="description" rows="3" class="md:col-span-2 rounded-xl border border-slate-600 bg-slate-900 px-2 py-2 text-sm text-white"><%= candidate.description || '' %></textarea>
                <button type="submit" class="md:col-span-2 rounded-xl bg-sky-500 px-3 py-2 text-sm font-bold text-slate-950">Update Candidate</button>
              </form>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
</body>
</html>
