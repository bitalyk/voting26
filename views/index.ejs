<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= t.eventTitle %></title>
  <%- include('partials/header', { siteConfig }) %>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/public-theme.css" />
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
      color: #e2e8f0;
    }
    .glass {
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(8px);
    }
  </style>
</head>
<body class="min-h-screen antialiased">
  <main class="mx-auto max-w-md space-y-5 px-4 py-5">
    <% mainPagePanels.forEach((panel) => { %>
      <% if (panel.panelId === 'header') { %>
        <header class="glass rounded-3xl border border-slate-700 p-4 shadow-xl shadow-slate-950/30"><div class="flex items-center justify-between gap-3"><div><p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-sky-400"><%= panel.displayBrand %></p><h1 class="mt-1 text-xl font-bold text-white"><%= panel.displayTitle %></h1></div><label class="flex items-center rounded-full border border-slate-600 bg-slate-800 px-2 py-1 text-xs text-slate-200"><select id="languageSwitcher" aria-label="Language" class="bg-transparent font-medium outline-none"><option value="en" <%= lang === 'en' ? 'selected' : '' %>>EN</option><option value="ru" <%= lang === 'ru' ? 'selected' : '' %>>RU</option><option value="ro" <%= lang === 'ro' ? 'selected' : '' %>>RO</option></select></label></div><div id="telegramGreeting" class="mt-4 hidden rounded-2xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm font-semibold text-emerald-100"></div></header>
      <% } else if (panel.panelId === 'schedule') { %>
        <section id="scheduleBanner" data-schedule-events='<%= JSON.stringify(scheduleEvents || []) %>' class="glass rounded-3xl border border-violet-400/40 p-4 shadow-xl shadow-violet-950/20"><div class="flex items-center justify-between gap-3"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-violet-300"><%= panel.displayTitle %></p><span class="h-2 w-2 rounded-full bg-emerald-400"></span></div><div class="mt-3 rounded-2xl bg-slate-900/60 p-3"><p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-sky-300"><%= t.currentEvent %></p><p id="currentScheduleTitle" class="mt-1 font-bold text-white"><%= t.noCurrentEvent %></p><p id="currentScheduleTime" class="mt-1 text-xs text-slate-400"></p></div><div class="mt-2 border-l-2 border-violet-400/70 pl-3"><p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-violet-300"><%= t.nextEvent %></p><p id="nextScheduleTitle" class="mt-1 text-sm font-semibold text-slate-100"><%= t.noNextEvent %></p><p id="nextScheduleTime" class="mt-1 text-xs text-slate-400"></p></div><label class="mt-4 flex cursor-pointer items-center justify-between gap-3 rounded-2xl border border-slate-700 bg-slate-900/50 px-3 py-2.5 text-sm text-slate-200"><span><%= t.notifyWhenEventsStart %></span><span class="relative inline-flex h-6 w-11 shrink-0 items-center"><input id="scheduleNotificationsToggle" type="checkbox" class="peer sr-only" disabled /><span class="absolute inset-0 rounded-full bg-slate-600 transition peer-checked:bg-emerald-400 peer-disabled:opacity-50"></span><span class="absolute left-1 h-4 w-4 rounded-full bg-white transition peer-checked:translate-x-5"></span></span></label><p id="scheduleNotificationHint" class="mt-2 text-xs text-slate-400"><%= t.notificationUnavailable %></p></section>
      <% } else if (panel.panelId === 'voting') { %>
        <section class="glass rounded-3xl border border-slate-700 p-5 shadow-2xl shadow-sky-900/10"><p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400"><%= t.eventLabel %></p><h2 class="mt-3 text-3xl font-black text-white"><%= panel.displayTitle %></h2><p class="mt-2 text-sm leading-6 text-slate-300"><%= panel.displayDescription %></p><% if (settings.showSoonText || settings.allowTestVoting) { %><div class="mt-4 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200"><%= settings.showSoonText ? t.soon : t.votingOpen %></div><% } else if (countdown) { %><div id="countdownBlock" class="mt-4 rounded-2xl border border-sky-500/40 bg-sky-500/10 p-4" data-target-time="<%= new Date(settings.votingStartTimestamp).getTime() %>"><p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300"><%= t.countdownLabel %></p><div class="mt-3 grid grid-cols-4 gap-2 text-center"><% [['days',t.timerDays,countdown.days],['hours',t.timerHours,countdown.hours],['minutes',t.timerMinutes,countdown.minutes],['seconds',t.timerSeconds,countdown.seconds]].forEach((item)=>{ %><div class="rounded-xl bg-slate-900/60 p-2"><div id="countdown-<%= item[0] %>" class="text-xl font-black text-white"><%= item[2] %></div><div class="text-[10px] uppercase text-slate-400"><%= item[1] %></div></div><% }) %></div><label class="mt-4 flex cursor-pointer items-center justify-between gap-3 rounded-2xl border border-slate-700 bg-slate-900/50 px-3 py-2.5 text-sm text-slate-200"><span><%= t.notifyWhenVotingStarts %></span><span class="relative inline-flex h-6 w-11 shrink-0 items-center"><input id="votingStartNotificationsToggle" type="checkbox" class="peer sr-only" disabled /><span class="absolute inset-0 rounded-full bg-slate-600 transition peer-checked:bg-emerald-400 peer-disabled:opacity-50"></span><span class="absolute left-1 h-4 w-4 rounded-full bg-white transition peer-checked:translate-x-5"></span></span></label><p id="votingStartNotificationHint" class="mt-2 text-xs text-slate-400"><%= t.notificationUnavailable %></p></div><% } %></section>
      <% } else if (panel.panelId === 'startVoting') { %>
        <section><button id="startVotingButton" type="button" data-voting-open="<%= votingOpen %>" data-show-soon="<%= settings.showSoonText %>" class="w-full rounded-2xl bg-sky-500 px-4 py-3 text-base font-bold text-slate-950 shadow-lg shadow-sky-500/30 transition hover:bg-sky-400 disabled:cursor-not-allowed disabled:bg-slate-500 disabled:text-slate-200 disabled:shadow-none"><%= panel.displayTitle %></button></section>
      <% } else if (panel.panelId === 'leaderboard') { %>
        <section><a href="/leaderboard?lang=<%= lang %>" class="block w-full rounded-2xl border border-slate-600 bg-slate-800 px-4 py-3 text-center text-base font-bold text-slate-100 shadow-md shadow-slate-950/20 transition hover:border-sky-500 hover:text-sky-300"><%= panel.displayTitle %></a></section>
      <% } else if (panel.panelId === 'map') { %>
        <section><a href="/map?lang=<%= lang %>" class="block w-full rounded-2xl border border-emerald-500/60 bg-emerald-500/10 px-4 py-3 text-center text-base font-bold text-emerald-100"><%= panel.displayTitle %></a></section>
      <% } else if (panel.panelId === 'prizes') { %>
        <section id="prizeWheelPanel" class="hidden"><a id="prizeWheelButton" href="/prizes?lang=<%= lang %>" class="flex w-full items-center justify-center rounded-2xl bg-amber-400 px-4 py-3 text-center text-base font-bold text-slate-950 shadow-lg shadow-amber-500/20 transition hover:bg-amber-300"><%= panel.displayTitle %></a></section>
      <% } %>
    <% }) %>
  </main>

  <div id="authModal" class="fixed inset-0 hidden items-end justify-center bg-slate-950/70 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-3xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-white"><%= t.authPrompt %></h3>
        <button id="closeAuthModal" type="button" class="rounded-full border border-slate-600 px-2 py-1 text-xs text-slate-300"><%= t.close %></button>
      </div>
      <a id="telegramOpenLink" href="https://t.me/<%= telegramBotUsername %>/app" target="_blank" rel="noreferrer" class="mt-5 block rounded-2xl bg-sky-500 px-4 py-3 text-center text-sm font-bold text-slate-950">
        <%= t.openTelegram %>
      </a>
    </div>
  </div>

  <script>
    const lang = '<%= lang %>';
    const botUsername = '<%= telegramBotUsername %>';
    const modal = document.getElementById('authModal');
    const startVotingButton = document.getElementById('startVotingButton');
    const votingOpen = startVotingButton && startVotingButton.dataset.votingOpen === 'true';
    const showSoon = startVotingButton && startVotingButton.dataset.showSoon === 'true';
    const languageSwitcher = document.getElementById('languageSwitcher');
    const telegramApp = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
    const scheduleBanner = document.getElementById('scheduleBanner');
    let scheduleEvents = JSON.parse(scheduleBanner ? scheduleBanner.dataset.scheduleEvents || '[]' : '[]');
    const scheduleToggle = document.getElementById('scheduleNotificationsToggle');
    const scheduleHint = document.getElementById('scheduleNotificationHint');
    const votingStartToggle = document.getElementById('votingStartNotificationsToggle');
    const votingStartHint = document.getElementById('votingStartNotificationHint');

    const scheduleTitle = (event) => event && event.title ? (event.title[lang] || event.title.en || event.title.ru || event.title.ro || '') : '';
    const formatScheduleTime = (event) => event ? new Intl.DateTimeFormat(lang === 'ru' ? 'ru-RU' : (lang === 'ro' ? 'ro-RO' : 'en-US'), { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(event.startTime)) : '';
    const renderSchedule = () => {
      if (!scheduleBanner) return;
      const now = Date.now();
      const currentEvents = scheduleEvents.filter((event, index) => {
        const startTime = new Date(event.startTime).getTime();
        const nextStartTime = scheduleEvents[index + 1] ? new Date(scheduleEvents[index + 1].startTime).getTime() : Infinity;
        const endTime = event.endTime ? new Date(event.endTime).getTime() : nextStartTime;
        return startTime <= now && now < endTime;
      });
      const current = currentEvents.length ? currentEvents[currentEvents.length - 1] : null;
      const next = scheduleEvents.find((event) => new Date(event.startTime).getTime() > now) || null;
      document.getElementById('currentScheduleTitle').textContent = current ? scheduleTitle(current) : '<%= t.noCurrentEvent %>';
      document.getElementById('currentScheduleTime').textContent = current ? formatScheduleTime(current) : '';
      document.getElementById('nextScheduleTitle').textContent = next ? scheduleTitle(next) : '<%= t.noNextEvent %>';
      document.getElementById('nextScheduleTime').textContent = next ? formatScheduleTime(next) : '';
    };
    const refreshSchedule = async () => {
      try {
        const response = await fetch('/api/schedule');
        const result = await response.json();
        if (response.ok && result.success) {
          scheduleEvents = result.events || [];
          renderSchedule();
        }
      } catch (error) {}
    };

    const telegramUser = telegramApp && telegramApp.initDataUnsafe ? telegramApp.initDataUnsafe.user : null;
    if (telegramUser) {
      const displayName = telegramUser.username ? `@${telegramUser.username}` : (telegramUser.first_name || 'User');
      const greeting = document.getElementById('telegramGreeting');
      if (greeting) {
        greeting.textContent = `<%= t.userHello %>, ${displayName}!`;
        greeting.classList.remove('hidden');
      }
      telegramApp.ready();

      fetch('/api/telegram-auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ initData: telegramApp.initData })
      })
        .then((response) => response.ok ? response.json() : null)
        .then((result) => {
          if (result && result.success) {
            if (scheduleToggle) scheduleToggle.disabled = false;
            if (scheduleToggle) scheduleToggle.checked = Boolean(result.scheduleNotificationsEnabled);
            if (scheduleHint) scheduleHint.classList.add('hidden');
            if (votingStartToggle) votingStartToggle.disabled = false;
            if (votingStartToggle) votingStartToggle.checked = Boolean(result.votingStartNotificationsEnabled);
            if (votingStartHint) votingStartHint.classList.add('hidden');
          }
          if (result && result.success && result.allowedPrizes) {
            document.getElementById('prizeWheelPanel')?.classList.remove('hidden');
          }
        })
        .catch(() => {});
    }

    const applyLanguage = async (nextLang) => {
      localStorage.setItem('votingLang', nextLang);
      if (telegramApp && telegramApp.initData) {
        try {
          await fetch('/api/user/language', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ initData: telegramApp.initData, languageCode: nextLang })
          });
        } catch (error) {}
      }
      const url = new URL(window.location.href);
      url.searchParams.set('lang', nextLang);
      window.location.href = url.toString();
    };

    const updateCountdown = () => {
      const countdownBlock = document.getElementById('countdownBlock');
      if (!countdownBlock) {
        return;
      }

      const targetTime = Number(countdownBlock.dataset.targetTime);
      if (!targetTime) {
        return;
      }

      const distance = Math.max(targetTime - Date.now(), 0);
      const totalSeconds = Math.floor(distance / 1000);
      const days = Math.floor(totalSeconds / (60 * 60 * 24));
      const hours = Math.floor((totalSeconds % (60 * 60 * 24)) / (60 * 60));
      const minutes = Math.floor((totalSeconds % (60 * 60)) / 60);
      const seconds = totalSeconds % 60;

      document.getElementById('countdown-days').textContent = days;
      document.getElementById('countdown-hours').textContent = hours;
      document.getElementById('countdown-minutes').textContent = minutes;
      document.getElementById('countdown-seconds').textContent = seconds;

      if (distance <= 0) {
        clearInterval(window.countdownInterval);
        window.location.reload();
      }
    };

    const setVoteButtonState = async () => {
      if (!startVotingButton) return;
      if (!votingOpen || showSoon) {
        startVotingButton.disabled = true;
        startVotingButton.textContent = showSoon ? '<%= t.soon %>' : '<%= t.votingNotStarted %>';
        startVotingButton.classList.add('opacity-80');
        return;
      }

      if (!telegramApp || !telegramApp.initData) {
        startVotingButton.disabled = false;
        startVotingButton.textContent = '<%= t.startVoting %>';
        startVotingButton.classList.remove('opacity-80');
        return;
      }

      try {
        const response = await fetch('/api/telegram-auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ initData: telegramApp.initData })
        });

        const data = await response.json();
        if (data && data.success && data.voted) {
          startVotingButton.disabled = true;
          startVotingButton.textContent = '<%= t.alreadyVoted %>';
          startVotingButton.classList.add('opacity-80');
          return;
        }
      } catch (error) {}

      startVotingButton.disabled = false;
      startVotingButton.textContent = '<%= t.startVoting %>';
      startVotingButton.classList.remove('opacity-80');
    };

    languageSwitcher?.addEventListener('change', (event) => {
      applyLanguage(event.target.value);
    });

    scheduleToggle?.addEventListener('change', async () => {
      if (!telegramApp || !telegramApp.initData) return;
      const enabled = scheduleToggle.checked;
      scheduleToggle.disabled = true;
      try {
        const response = await fetch('/api/user/toggle-notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ initData: telegramApp.initData, enabled })
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Request failed.');
        scheduleToggle.checked = Boolean(result.scheduleNotificationsEnabled);
      } catch (error) {
        scheduleToggle.checked = !enabled;
      } finally {
        scheduleToggle.disabled = false;
      }
    });

    votingStartToggle?.addEventListener('change', async () => {
      if (!telegramApp || !telegramApp.initData) return;
      const enabled = votingStartToggle.checked;
      votingStartToggle.disabled = true;
      try {
        const response = await fetch('/api/user/toggle-voting-start-notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ initData: telegramApp.initData, enabled })
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Request failed.');
        votingStartToggle.checked = Boolean(result.votingStartNotificationsEnabled);
      } catch (error) {
        votingStartToggle.checked = !enabled;
      } finally {
        votingStartToggle.disabled = false;
      }
    });

    if (!localStorage.getItem('votingLang')) {
      localStorage.setItem('votingLang', lang);
    }

    document.getElementById('closeAuthModal').addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    startVotingButton?.addEventListener('click', async () => {
      if (startVotingButton.disabled || !votingOpen || showSoon) {
        return;
      }

      if (telegramApp && telegramApp.initData) {
        window.location.href = `/vote?lang=${encodeURIComponent(localStorage.getItem('votingLang') || lang)}`;
        return;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.getElementById('telegramOpenLink').href = `https://t.me/${botUsername}/app`;
    });

    setVoteButtonState();
    renderSchedule();
    window.setInterval(refreshSchedule, 30000);
    if (document.getElementById('countdownBlock')) {
      updateCountdown();
      window.countdownInterval = setInterval(updateCountdown, 1000);
    }
  </script>
</body>
</html>
