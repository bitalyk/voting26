<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= t.eventTitle %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
      color: #e2e8f0;
    }
    .glass {
      background: rgba(15, 23, 42, 0.8);
      backdrop-filter: blur(8px);
    }
  </style>
</head>
<body class="min-h-screen antialiased">
  <div class="mx-auto max-w-md px-4 py-5">
    <header class="glass mb-5 rounded-3xl border border-slate-700 p-4 shadow-xl shadow-slate-950/30">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-sky-400">GoCon</p>
          <h1 class="mt-1 text-xl font-bold text-white"><%= t.eventTitle %></h1>
        </div>
        <label class="flex items-center gap-2 rounded-full border border-slate-600 bg-slate-800 px-2 py-1 text-xs text-slate-200">
          <span>🌐</span>
          <select id="languageSwitcher" class="bg-transparent font-medium outline-none">
            <option value="en" <%= lang === 'en' ? 'selected' : '' %>>EN</option>
            <option value="ru" <%= lang === 'ru' ? 'selected' : '' %>>RU</option>
            <option value="ro" <%= lang === 'ro' ? 'selected' : '' %>>RO</option>
          </select>
        </label>
      </div>
    </header>

    <main class="space-y-5">
      <section class="glass rounded-3xl border border-slate-700 p-5 shadow-2xl shadow-sky-900/10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400"><%= t.eventLabel %></p>
        <h2 class="mt-3 text-3xl font-black text-white"><%= t.eventTitle %></h2>
        <p class="mt-2 text-sm leading-6 text-slate-300"><%= t.eventSubtitle %></p>
        <div id="telegramGreeting" class="mt-4 hidden rounded-2xl border border-emerald-500/40 bg-emerald-500/10 px-4 py-3 text-sm font-semibold text-emerald-100"></div>

        <% if (settings.showSoonText || settings.allowTestVoting) { %>
          <div class="mt-4 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-200">
            <%= settings.showSoonText ? t.soon : t.votingOpen %>
          </div>
        <% } else if (countdown) { %>
          <div id="countdownBlock" class="mt-4 rounded-2xl border border-sky-500/40 bg-sky-500/10 p-4" data-target-time="<%= new Date(settings.votingStartTimestamp).getTime() %>">
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-sky-300"><%= t.countdownLabel %></p>
            <div class="mt-3 grid grid-cols-4 gap-2 text-center">
              <div class="rounded-xl bg-slate-900/60 p-2">
                <div id="countdown-days" class="text-xl font-black text-white"><%= countdown.days %></div>
                <div class="text-[10px] uppercase text-slate-400"><%= t.timerDays %></div>
              </div>
              <div class="rounded-xl bg-slate-900/60 p-2">
                <div id="countdown-hours" class="text-xl font-black text-white"><%= countdown.hours %></div>
                <div class="text-[10px] uppercase text-slate-400"><%= t.timerHours %></div>
              </div>
              <div class="rounded-xl bg-slate-900/60 p-2">
                <div id="countdown-minutes" class="text-xl font-black text-white"><%= countdown.minutes %></div>
                <div class="text-[10px] uppercase text-slate-400"><%= t.timerMinutes %></div>
              </div>
              <div class="rounded-xl bg-slate-900/60 p-2">
                <div id="countdown-seconds" class="text-xl font-black text-white"><%= countdown.seconds %></div>
                <div class="text-[10px] uppercase text-slate-400"><%= t.timerSeconds %></div>
              </div>
            </div>
          </div>
        <% } %>

        <button id="startVotingButton" type="button" data-voting-open="<%= votingOpen %>" data-show-soon="<%= settings.showSoonText %>" class="mt-5 w-full rounded-2xl bg-sky-500 px-4 py-3 text-base font-bold text-slate-950 shadow-lg shadow-sky-500/30 transition hover:bg-sky-400 disabled:cursor-not-allowed disabled:bg-slate-500 disabled:text-slate-200 disabled:shadow-none">
          <%= votingOpen ? t.startVoting : t.votingNotStarted %>
        </button>

        <a href="/leaderboard?lang=<%= lang %>" class="mt-3 block w-full rounded-2xl border border-slate-600 bg-slate-800 px-4 py-3 text-center text-base font-bold text-slate-100 shadow-md shadow-slate-950/20 transition hover:border-sky-500 hover:text-sky-300">
          <%= t.leaderboardTitle %>
        </a>
        <a href="/map?lang=<%= lang %>" class="mt-3 block w-full rounded-2xl border border-emerald-500/60 bg-emerald-500/10 px-4 py-3 text-center text-base font-bold text-emerald-100"><%= t.interactiveMap %></a>
        <a id="prizeWheelButton" href="/prizes?lang=<%= lang %>" class="mt-3 hidden flex w-full items-center justify-center rounded-2xl bg-amber-400 px-4 py-3 text-center text-base font-bold text-slate-950 shadow-lg shadow-amber-500/20 transition hover:bg-amber-300">
          <%= t.prizeWheel %>
        </a>
      </section>
    </main>
  </div>

  <div id="authModal" class="fixed inset-0 hidden items-end justify-center bg-slate-950/70 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-3xl border border-slate-700 bg-slate-900 p-5 shadow-2xl">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-bold text-white"><%= t.authPrompt %></h3>
        <button id="closeAuthModal" type="button" class="rounded-full border border-slate-600 px-2 py-1 text-xs text-slate-300"><%= t.close %></button>
      </div>
      <a id="telegramOpenLink" href="https://t.me/<%= telegramBotUsername %>/app" target="_blank" rel="noreferrer" class="mt-5 block rounded-2xl bg-sky-500 px-4 py-3 text-center text-sm font-bold text-slate-950">
        <%= t.openTelegram %>
      </a>
    </div>
  </div>

  <script>
    const lang = '<%= lang %>';
    const botUsername = '<%= telegramBotUsername %>';
    const modal = document.getElementById('authModal');
    const startVotingButton = document.getElementById('startVotingButton');
    const votingOpen = startVotingButton.dataset.votingOpen === 'true';
    const showSoon = startVotingButton.dataset.showSoon === 'true';
    const languageSwitcher = document.getElementById('languageSwitcher');
    const telegramApp = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;

    const telegramUser = telegramApp && telegramApp.initDataUnsafe ? telegramApp.initDataUnsafe.user : null;
    if (telegramUser) {
      const displayName = telegramUser.username ? `@${telegramUser.username}` : (telegramUser.first_name || 'User');
      const greeting = document.getElementById('telegramGreeting');
      greeting.textContent = `<%= t.userHello %>, ${displayName}!`;
      greeting.classList.remove('hidden');
      telegramApp.ready();

      fetch('/api/telegram-auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ initData: telegramApp.initData })
      })
        .then((response) => response.ok ? response.json() : null)
        .then((result) => {
          if (result && result.success && result.allowedPrizes) {
            document.getElementById('prizeWheelButton').classList.remove('hidden');
          }
        })
        .catch(() => {});
    }

    const applyLanguage = (nextLang) => {
      localStorage.setItem('votingLang', nextLang);
      const url = new URL(window.location.href);
      url.searchParams.set('lang', nextLang);
      window.location.href = url.toString();
    };

    const updateCountdown = () => {
      const countdownBlock = document.getElementById('countdownBlock');
      if (!countdownBlock) {
        return;
      }

      const targetTime = Number(countdownBlock.dataset.targetTime);
      if (!targetTime) {
        return;
      }

      const distance = Math.max(targetTime - Date.now(), 0);
      const totalSeconds = Math.floor(distance / 1000);
      const days = Math.floor(totalSeconds / (60 * 60 * 24));
      const hours = Math.floor((totalSeconds % (60 * 60 * 24)) / (60 * 60));
      const minutes = Math.floor((totalSeconds % (60 * 60)) / 60);
      const seconds = totalSeconds % 60;

      document.getElementById('countdown-days').textContent = days;
      document.getElementById('countdown-hours').textContent = hours;
      document.getElementById('countdown-minutes').textContent = minutes;
      document.getElementById('countdown-seconds').textContent = seconds;

      if (distance <= 0) {
        clearInterval(window.countdownInterval);
        window.location.reload();
      }
    };

    const setVoteButtonState = async () => {
      if (!votingOpen || showSoon) {
        startVotingButton.disabled = true;
        startVotingButton.textContent = showSoon ? '<%= t.soon %>' : '<%= t.votingNotStarted %>';
        startVotingButton.classList.add('opacity-80');
        return;
      }

      if (!telegramApp || !telegramApp.initData) {
        startVotingButton.disabled = false;
        startVotingButton.textContent = '<%= t.startVoting %>';
        startVotingButton.classList.remove('opacity-80');
        return;
      }

      try {
        const response = await fetch('/api/telegram-auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ initData: telegramApp.initData })
        });

        const data = await response.json();
        if (data && data.success && data.voted) {
          startVotingButton.disabled = true;
          startVotingButton.textContent = '<%= t.alreadyVoted %>';
          startVotingButton.classList.add('opacity-80');
          return;
        }
      } catch (error) {}

      startVotingButton.disabled = false;
      startVotingButton.textContent = '<%= t.startVoting %>';
      startVotingButton.classList.remove('opacity-80');
    };

    languageSwitcher.addEventListener('change', (event) => {
      applyLanguage(event.target.value);
    });

    if (!localStorage.getItem('votingLang')) {
      localStorage.setItem('votingLang', lang);
    }

    document.getElementById('closeAuthModal').addEventListener('click', () => {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    });

    startVotingButton.addEventListener('click', async () => {
      if (startVotingButton.disabled || !votingOpen || showSoon) {
        return;
      }

      if (telegramApp && telegramApp.initData) {
        window.location.href = `/vote?lang=${encodeURIComponent(localStorage.getItem('votingLang') || lang)}`;
        return;
      }

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.getElementById('telegramOpenLink').href = `https://t.me/${botUsername}/app`;
    });

    setVoteButtonState();
    if (document.getElementById('countdownBlock')) {
      updateCountdown();
      window.countdownInterval = setInterval(updateCountdown, 1000);
    }
  </script>
</body>
</html>
