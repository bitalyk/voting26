<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Voting Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        html, body {
            background: #020617;
            -webkit-overflow-scrolling: touch;
        }

        body {
            min-height: 100vh;
            overscroll-behavior-y: contain;
        }

        .option-card {
            transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
        }

        .option-card:active {
            transform: scale(0.99);
        }

        input[type="radio"] {
            accent-color: #38bdf8;
        }
    </style>
</head>
<body class="text-slate-100 antialiased">
    <div class="mx-auto min-h-screen max-w-md px-4 py-4">
        <div id="loadingState" class="rounded-3xl border border-slate-700 bg-slate-900/80 p-6 shadow-2xl shadow-sky-900/20 backdrop-blur-sm">
            <div class="flex items-center justify-center gap-3 text-sky-300">
                <span class="h-3 w-3 animate-pulse rounded-full bg-sky-400"></span>
                <span class="text-sm font-medium tracking-[0.18em] uppercase">Authenticating</span>
            </div>
            <p class="mt-4 text-center text-sm text-slate-300">Connecting your Telegram account…</p>
        </div>

        <div id="alreadyVotedState" class="hidden rounded-3xl border border-emerald-500/40 bg-emerald-500/10 p-6 text-center shadow-xl shadow-emerald-500/10">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-500/20 text-3xl">✅</div>
            <h2 class="mt-5 text-2xl font-bold text-white">Already voted</h2>
            <p class="mt-3 text-sm text-slate-200">Your Telegram account has already submitted a vote. Thanks for participating.</p>
            <a href="/leaderboard" class="mt-6 block rounded-2xl bg-sky-500 px-4 py-3 text-sm font-semibold text-slate-950 shadow-lg shadow-sky-500/30">View live results</a>
        </div>

        <form id="voteForm" class="hidden space-y-5">
            <div class="rounded-3xl border border-slate-700 bg-slate-900/80 p-4 shadow-2xl shadow-sky-900/20 backdrop-blur-sm">
                <p class="text-xs font-medium uppercase tracking-[0.2em] text-sky-400">Voting portal</p>
                <div class="mt-3 flex items-center justify-between gap-3">
                    <div>
                        <h1 class="text-2xl font-bold text-white">Cast your vote</h1>
                        <p id="userBadge" class="mt-1 text-sm text-slate-300">Hello, guest</p>
                    </div>
                    <div class="rounded-full border border-sky-500/40 bg-sky-500/10 px-3 py-1 text-xs font-semibold text-sky-300">TWA</div>
                </div>
            </div>

            <% Object.keys(categories).forEach(categoryId => { %>
                <section class="rounded-3xl border border-slate-700 bg-slate-900/80 p-4 shadow-lg shadow-slate-950/30">
                    <div class="mb-3 flex items-center justify-between">
                        <h2 class="text-lg font-semibold text-white"><%= categories[categoryId].name %></h2>
                        <span class="rounded-full border border-slate-600 bg-slate-800 px-2 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-slate-300">Select one</span>
                    </div>

                    <div class="space-y-2.5">
                        <% categories[categoryId].items.forEach(candidate => { %>
                            <label class="option-card flex cursor-pointer items-center gap-3 rounded-2xl border border-slate-700 bg-slate-800/80 p-3 text-left hover:border-sky-500/60 hover:bg-slate-800">
                                <input type="radio" name="cat<%= categoryId %>" value="<%= candidate.id %>" class="h-4 w-4" required />
                                <span class="flex-1 text-sm font-medium text-slate-100"><%= candidate.name %></span>
                            </label>
                        <% }) %>
                    </div>
                </section>
            <% }) %>
        </form>
    </div>

    <script>
        const tg = window.Telegram && window.Telegram.WebApp ? window.Telegram.WebApp : null;
        const loadingState = document.getElementById('loadingState');
        const alreadyVotedState = document.getElementById('alreadyVotedState');
        const voteForm = document.getElementById('voteForm');
        const userBadge = document.getElementById('userBadge');

        function showState(state) {
            loadingState.classList.toggle('hidden', state !== 'loading');
            alreadyVotedState.classList.toggle('hidden', state !== 'already-voted');
            voteForm.classList.toggle('hidden', state !== 'vote');
        }

        function getSelectedVotePayload() {
            const payload = {};
            ['cat1', 'cat2', 'cat3'].forEach((key) => {
                const selected = document.querySelector(`input[name="${key}"]:checked`);
                if (!selected) {
                    payload[key] = null;
                    return;
                }
                payload[key] = selected.value;
            });
            return payload;
        }

        function validateVotePayload(payload) {
            return payload.cat1 && payload.cat2 && payload.cat3;
        }

        async function submitVote() {
            if (!tg || !tg.initData) {
                window.alert('This voting portal must be opened inside Telegram.');
                return;
            }

            const payload = getSelectedVotePayload();
            if (!validateVotePayload(payload)) {
                window.alert('Please select one option in each category before submitting.');
                return;
            }

            const response = await fetch('/api/telegram-vote', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    initData: tg.initData,
                    categoryVotes: payload
                })
            });

            const result = await response.json();
            if (!response.ok || !result.success) {
                window.alert(result.error || 'Vote submission failed.');
                return;
            }

            if (tg.MainButton) {
                tg.MainButton.hide();
            }
            showState('already-voted');
        }

        async function initializeTelegramAuth() {
            if (!tg) {
                showState('vote');
                userBadge.textContent = 'Telegram not detected in this browser';
                return;
            }

            tg.ready();
            tg.expand();

            if (tg.MainButton) {
                tg.MainButton.setText('SUBMIT VOTE');
                tg.MainButton.onClick(submitVote);
                tg.MainButton.show();
            }

            const user = tg.initDataUnsafe && tg.initDataUnsafe.user ? tg.initDataUnsafe.user : null;
            const displayName = user ? (user.first_name || user.username || 'Telegram User') : 'Telegram User';
            userBadge.textContent = `Hello, ${displayName}`;

            if (!tg.initData) {
                showState('vote');
                return;
            }

            const authResponse = await fetch('/api/telegram-auth', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ initData: tg.initData })
            });

            const result = await authResponse.json();

            if (!authResponse.ok || !result.success) {
                userBadge.textContent = 'Authentication failed';
                showState('vote');
                return;
            }

            if (result.voted) {
                showState('already-voted');
                if (tg.MainButton) {
                    tg.MainButton.hide();
                }
                return;
            }

            showState('vote');
            if (tg.MainButton) {
                tg.MainButton.show();
            }
        }

        initializeTelegramAuth();
    </script>
</body>
</html>