<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Event Voting Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="bg-white p-8 rounded-lg shadow-md text-center max-w-md">
        <h1 class="text-3xl font-bold text-gray-800 mb-4">Event Voting System</h1>
        <p class="text-gray-600 text-sm mb-6">Scan your event QR code to participate in the voting process.</p>
        <div class="space-y-3">
            <a href="/leaderboard" class="block w-full bg-indigo-600 text-white py-2 rounded font-semibold hover:bg-indigo-700">View Live Results</a>
            <a href="/qr" class="block w-full bg-gray-200 text-gray-700 py-2 rounded font-semibold hover:bg-gray-300">Admin QR Generator</a>
        </div>
    </div>
</body>
</html>